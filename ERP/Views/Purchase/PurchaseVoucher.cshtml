@model ERP.Models.PurchaseViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Purchase Voucher";
    var purchaseList = ViewBag.Purchase as List<ERP.Models.PurchaseListDto>;

    int    currentPage = (int)(ViewBag.Page      ?? 1);
    int    pageSize    = (int)(ViewBag.PageSize   ?? 5);
    int    totalItems  = (int)(ViewBag.TotalItems ?? 0);
    string activeTab   = ViewBag.ActiveTab as string ?? "form";

    int startItem = totalItems == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    int endItem   = Math.Min(currentPage * pageSize, totalItems);

    var taxSetupList = ViewBag.TaxSetup as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var taxJson = JsonSerializer.Serialize(taxSetupList.Select(t => new {
        id         = (int)t.Id,
        tax_name   = (string)t.tax_name,
        percentage = (decimal)t.percentage
    }));

    var banksList = ViewBag.Banks as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="space-y-8">

    @* ═══ MAIN TAB HEADER ═══ *@
    <div class="border-b border-gray-300 bg-white shadow-sm rounded-xl p-2">
        <nav class="flex space-x-6" aria-label="Tabs">
            <button id="tab-form" type="button"
                    class="px-4 py-2 text-sm font-semibold @(activeTab == "form" ? "text-blue-900 border-b-2 border-blue-900" : "text-gray-500 hover:text-blue-900")">
                <i class="fa-solid fa-plus-circle mr-2"></i> Purchase Voucher Entry
            </button>
            <button id="tab-list" type="button"
                    class="px-4 py-2 text-sm font-semibold @(activeTab == "list" ? "text-blue-900 border-b-2 border-blue-900" : "text-gray-500 hover:text-blue-900")">
                <i class="fa-solid fa-list mr-2"></i> Purchase Voucher List
            </button>
        </nav>
    </div>

    @* ═══ FORM TAB ═══ *@
    <div id="content-form" class="@(activeTab == "list" ? "hidden" : "")">
        @using (Html.BeginForm("Create", "PurchaseVoucher", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.StockMaster.Id,             new { id = "StockMasterId" })
            @Html.HiddenFor(m => m.StockMaster.companyId)
            @Html.HiddenFor(m => m.StockMaster.userId)
            @Html.HiddenFor(m => m.StockMaster.payment_status)
            <input type="hidden" name="StockMaster.etype" value="Purchase" />

            @* Header *@
            <div class="shadow-lg rounded-2xl bg-gradient-to-r from-blue-50 to-blue-100 p-6 border border-gray-200">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-2xl font-bold text-blue-800 flex items-center gap-2">
                            <i class="fa-solid fa-boxes text-blue-900"></i> Purchase Voucher
                        </h2>
                        <p class="text-gray-600 mt-1 text-sm">Add and manage purchase voucher details</p>
                    </div>
                    <div class="space-x-2">
                        <button type="submit" onclick="return beforeSave()"
                                class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-green-600 hover:bg-green-700 shadow-md transition">
                            <i class="fa-solid fa-save mr-2"></i> Save
                        </button>
                        <button type="reset" onclick="resetForm()"
                                class="px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 bg-yellow-300 hover:bg-yellow-400 shadow-md transition">
                            <i class="fa-solid fa-rotate-right mr-2"></i> Reset
                        </button>
                        <button type="button" onclick="printVoucher()"
                                class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 shadow-md transition">
                            <i class="fa-solid fa-print mr-2"></i> Print
                        </button>
                    </div>
                </div>
            </div>

            @* Master Fields *@
            <div class="shadow-md rounded-2xl bg-white p-6 border border-gray-200 mt-4">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">
                            VrNo <sup class="text-red-800 text-lg">*</sup>
                        </label>
                        @Html.TextBoxFor(m => m.StockMaster.voucher_no,
                            new { @class = "w-full p-2 border rounded-lg bg-gray-50",
                                  type = "number", required = "required", @readonly = "readonly" })
                    </div>

                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">
                            Current Date <sup class="text-red-800 text-lg">*</sup>
                        </label>
                        @Html.TextBoxFor(m => m.StockMaster.current_date, "{0:yyyy-MM-dd}",
                            new { @class = "w-full p-2 border rounded-lg", type = "date", required = "required" })
                    </div>

                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">
                            Due Date <sup class="text-red-800 text-lg">*</sup>
                        </label>
                        @Html.TextBoxFor(m => m.StockMaster.due_date, "{0:yyyy-MM-dd}",
                            new { @class = "w-full p-2 border rounded-lg", type = "date", required = "required" })
                    </div>

                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">
                            Posted Date <sup class="text-red-800 text-lg">*</sup>
                        </label>
                        @Html.TextBoxFor(m => m.StockMaster.posted_date, "{0:yyyy-MM-dd}",
                            new { @class = "w-full p-2 border rounded-lg", type = "date", required = "required" })
                    </div>

                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">
                            Vendor <sup class="text-red-800 text-lg">*</sup>
                            <a href="javascript:void(0)" onclick="openVenderModal()"
                               class="inline-flex items-center px-3 py-1 text-xs text-blue-600 font-semibold hover:text-blue-800">
                                <i class="fa-solid fa-plus mr-1"></i> Add New
                            </a>
                        </label>
                        <select id="venderId" name="StockMaster.venderId" class="w-full p-2 border rounded-lg" required>
                            <option value="">Select Vendor</option>
                            @foreach (var vender in ViewBag.Venders)
                            {
                                <option value="@vender.Id"
                                        selected="@(Model.StockMaster.venderId == vender.Id ? "selected" : null)">
                                    @vender.name
                                </option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">
                            Transporter
                            <a href="javascript:void(0)" onclick="openTransporterModal()"
                               class="inline-flex items-center px-3 py-1 text-xs text-blue-600 font-semibold hover:text-blue-800">
                                <i class="fa-solid fa-plus mr-1"></i> Add New
                            </a>
                        </label>
                        <select id="transporterId" name="StockMaster.transporterId" class="w-full p-2 border rounded-lg">
                            <option value="">Select Transporter</option>
                            @foreach (var transporter in ViewBag.Transporters)
                            {
                                <option value="@transporter.Id"
                                        selected="@(Model.StockMaster.transporterId == transporter.Id ? "selected" : null)">
                                    @transporter.transporter_no
                                </option>
                            }
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block font-semibold text-gray-700 mb-1">Remarks</label>
                        @Html.TextAreaFor(m => m.StockMaster.remarks,
                            new { @class = "w-full p-2 border rounded-lg", rows = "2", placeholder = "Enter Remarks" })
                    </div>

                </div>
            </div>

            @* Detail Inner Tabs *@
            <div class="shadow-md rounded-2xl bg-white p-6 border mt-4">
                <nav class="flex space-x-6 mb-6 border-b pb-2">
                    <button id="tab-stock-details" type="button"
                            class="px-4 py-2 text-sm font-semibold text-blue-900 border-b-2 border-blue-900">
                        <i class="fa-solid fa-box mr-2"></i> Stock Details
                    </button>
                    <button id="tab-additional-charges" type="button"
                            class="px-4 py-2 text-sm font-semibold text-gray-500 hover:text-blue-900">
                        <i class="fa-solid fa-money-bill mr-2"></i> Additional Charges
                    </button>
                    <button id="tab-payment" type="button"
                            class="px-4 py-2 text-sm font-semibold text-gray-500 hover:text-blue-900">
                        <i class="fa-solid fa-credit-card mr-2"></i> Payment
                    </button>
                </nav>

                @* ─── Stock Details ─── *@
                <div id="content-stock-details">
                    <h3 class="text-lg font-semibold mb-4 text-gray-700">Add Stock Details</h3>
                    <div class="grid grid-cols-12 gap-4 items-end">

                        <div class="col-span-3">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">
                                Warehouse <sup class="text-red-800">*</sup>
                                <a href="javascript:void(0)" onclick="openWarehouseModal()"
                                   class="text-xs text-blue-600 hover:text-blue-800 ml-1">
                                    <i class="fa-solid fa-plus mr-1"></i> Add New
                                </a>
                            </label>
                            <select id="warehouseId" class="w-full p-2 border rounded-lg">
                                <option value="">Select Warehouse</option>
                                @foreach (var warehouse in ViewBag.Warehouses as IEnumerable<dynamic>)
                                {
                                    <option value="@warehouse.Id">@warehouse.warehouse_name</option>
                                }
                            </select>
                        </div>

                        <div class="col-span-3">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">
                                Item <sup class="text-red-800">*</sup>
                                <a href="javascript:void(0)" onclick="openItemModal()"
                                   class="text-xs text-blue-600 hover:text-blue-800 ml-1">
                                    <i class="fa-solid fa-plus mr-1"></i> Add New
                                </a>
                            </label>
                            <select id="itemId" class="w-full p-2 border rounded-lg" onchange="fetchPurchaseRate()">
                                <option value="">Select Item</option>
                                @foreach (var item in ViewBag.Items as IEnumerable<dynamic>)
                                {
                                    <option value="@item.Id">@item.item_name</option>
                                }
                            </select>
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Rate <sup class="text-red-800">*</sup></label>
                            <input type="number" id="rate" step="0.01" min="0" placeholder="0.00" class="w-full p-2 border rounded-lg" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Quantity <sup class="text-red-800">*</sup></label>
                            <input type="number" id="qty" min="1" placeholder="0" class="w-full p-2 border rounded-lg" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Amount</label>
                            <input type="number" id="amount" step="0.01" min="0" placeholder="0.00"
                                   readonly class="w-full p-2 border rounded-lg bg-gray-50" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Disc %</label>
                            <input type="number" id="discount_percentage" step="0.01" min="0" placeholder="0.00"
                                   class="w-full p-2 border rounded-lg" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Disc Amount</label>
                            <input type="number" id="discount_amount" step="0.01" min="0" placeholder="0.00"
                                   readonly class="w-full p-2 border rounded-lg bg-gray-50" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Excl Tax Amount</label>
                            <input type="number" id="net_amount" step="0.01" min="0" placeholder="0.00"
                                   readonly class="w-full p-2 border rounded-lg bg-gray-50" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Tax</label>
                            <select id="taxSetupId" class="w-full p-2 border rounded-lg" onchange="onTaxSetupChange()">
                                <option value="">-- No Tax --</option>
                                @foreach (var tax in taxSetupList)
                                {
                                    <option value="@tax.Id" data-percentage="@tax.percentage">
                                        @tax.tax_name (@tax.percentage%)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-span-2" id="gst-pct-col" style="display:none;">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">GST %</label>
                            <input type="number" id="gst" step="0.01" min="0" placeholder="0.00"
                                   readonly class="w-full p-2 border rounded-lg bg-gray-50" />
                        </div>

                        <div class="col-span-2" id="gst-amt-col" style="display:none;">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">GST Amount</label>
                            <input type="number" id="gst_amount" step="0.01" min="0" placeholder="0.00"
                                   readonly class="w-full p-2 border rounded-lg bg-gray-50" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Incl Tax Amount</label>
                            <input type="number" id="incl_Tax_Amount" step="0.01" min="0" placeholder="0.00"
                                   readonly class="w-full p-2 border rounded-lg bg-gray-50" />
                        </div>

                        <div class="col-span-12 flex justify-end">
                            <button type="button" id="btnAddDetail"
                                    class="px-6 py-2 rounded-xl text-sm font-semibold text-white bg-blue-900 hover:bg-blue-800 transition">
                                <i class="fa-solid fa-plus mr-2"></i> Add
                            </button>
                        </div>
                    </div>

                    <div id="addMessage" class="hidden mt-2 px-4 py-2 rounded-lg text-sm font-semibold"></div>

                    <div class="overflow-hidden border rounded-lg mt-6">
                        <div class="max-h-96 overflow-y-auto">
                            <table class="table-auto w-full text-sm" id="detailsTable">
                                <thead class="bg-gradient-to-r from-blue-800 to-blue-900 text-white sticky top-0">
                                    <tr>
                                        <th class="p-3">S.No</th>
                                        <th class="p-3">Date</th>
                                        <th class="p-3">Warehouse</th>
                                        <th class="p-3">Item</th>
                                        <th class="p-3">Qty</th>
                                        <th class="p-3">Rate</th>
                                        <th class="p-3">Amount</th>
                                        <th class="p-3">Dis %</th>
                                        <th class="p-3">Dis Amt</th>
                                        <th class="p-3">Excl Tax Amt</th>
                                        <th class="p-3">Tax</th>
                                        <th class="p-3">GST %</th>
                                        <th class="p-3">GST Amt</th>
                                        <th class="p-3">Incl Tax Amt</th>
                                        <th class="p-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @* ─── Additional Charges ─── *@
                <div id="content-additional-charges" class="hidden">
                    <h3 class="text-lg font-semibold mb-4 text-gray-700">Additional Charges</h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Total Amount</label>
                            @Html.TextBoxFor(m => m.StockMaster.total_amount,
                                new { @class = "w-full p-2 border rounded-lg bg-gray-50",
                                      type = "number", step = "0.01", @readonly = "readonly" })
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Discount Amount</label>
                            @Html.TextBoxFor(m => m.StockMaster.discount_amount,
                                new { @class = "w-full p-2 border rounded-lg",
                                      type = "number", step = "0.01", onchange = "updateNetAmount()" })
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Tax Amount</label>
                            @Html.TextBoxFor(m => m.StockMaster.tax_amount,
                                new { @class = "w-full p-2 border rounded-lg",
                                      type = "number", step = "0.01", onchange = "updateNetAmount()" })
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Net Amount</label>
                            @Html.TextBoxFor(m => m.StockMaster.net_amount,
                                new { @class = "w-full p-2 border rounded-lg bg-gray-50",
                                      type = "number", step = "0.01", @readonly = "readonly" })
                        </div>
                    </div>
                </div>

                @* ─── Payment Tab ─── *@
                <div id="content-payment" class="hidden">
                    <h3 class="text-lg font-semibold mb-4 text-gray-700">
                        <i class="fa-solid fa-credit-card mr-2 text-blue-700"></i> Payment Details
                    </h3>

                    <div class="mb-5 p-3 rounded-lg bg-blue-50 border border-blue-200 text-sm text-blue-700">
                        <i class="fa-solid fa-circle-info mr-2"></i>
                        Payment is optional. Leave MOP blank to save as <strong>Unpaid</strong>.
                        Fill details to save as <strong class="text-green-700">Paid</strong>.
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

                        @* ── MOP Dropdown — always visible ── *@
                      <div>
    <label class="block font-semibold text-gray-700 mb-1">MOP (Method of Payment)</label>
    @Html.DropDownList("PaymentVoucher.method",
        new SelectList(new[]
        {
            new { Value = "",       Text = "-- None (Unpaid) --" },
            new { Value = "Cash",   Text = "Cash"                },
            new { Value = "Cheque", Text = "Cheque"              },
            new { Value = "Bank",   Text = "Bank Transfer"       }
        }, "Value", "Text", Model.PaymentVoucher?.method ?? ""),
        new
        {
            id       = "paymentMethod",
            @class   = "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-400",
            onchange = "onPaymentMethodChange()"
        })
</div>

                        @* ── Amount — Cash / Cheque / Bank sab mein show ── *@
                        <div id="pay-amount-col" style="display:none;">
                            <label class="block font-semibold text-gray-700 mb-1">
                                Payment Amount <sup class="text-red-800 text-lg">*</sup>
                            </label>
                            @Html.TextBoxFor(m => m.PaymentVoucher.amount,
                                new { @class = "w-full p-2 border rounded-lg",
                                      type = "number", step = "0.01", min = "0",
                                      id = "payAmount", placeholder = "0.00" })
                        </div>

                        @* ── Bank Account — sirf Bank aur Cheque mein show ── *@
                        <div id="pay-bank-col" style="display:none;">
                            <label class="block font-semibold text-gray-700 mb-1">Bank Account</label>
                            <select id="bankAccountId" name="PaymentVoucher.bankAccountId"
                                    class="w-full p-2 border rounded-lg bg-white">
                                <option value="">-- Select Account --</option>
                                @foreach (var bank in banksList)
                                {
                                    <option value="@bank.Id"
                                            selected="@(Model.PaymentVoucher != null && Model.PaymentVoucher.bankAccountId == (int)bank.Id ? "selected" : null)">
                                        @bank.account_title
                                    </option>
                                }
                            </select>
                        </div>

                        @* ── Cheque No — sirf Cheque mein show ── *@
                        <div id="pay-cheque-no-col" style="display:none;">
                            <label class="block font-semibold text-gray-700 mb-1">Cheque No</label>
                            @Html.TextBoxFor(m => m.PaymentVoucher.cheque_no,
                                new { @class = "w-full p-2 border rounded-lg",
                                      type = "text", placeholder = "Enter Cheque Number" })
                        </div>

                        @* ── Cheque Date — sirf Cheque mein show ── *@
                        <div id="pay-cheque-date-col" style="display:none;">
                            <label class="block font-semibold text-gray-700 mb-1">Cheque Date</label>
                            @Html.TextBoxFor(m => m.PaymentVoucher.cheque_date,
                                new { @class = "w-full p-2 border rounded-lg", type = "date" })
                        </div>

                    </div>

                    @* Payment Summary Card *@
                    <div id="pay-summary-card" class="hidden mt-5 p-4 rounded-xl border-2 border-green-300 bg-green-50">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-full bg-green-600 flex items-center justify-center">
                                    <i class="fa-solid fa-check text-white text-sm"></i>
                                </div>
                                <div>
                                    <p class="font-semibold text-green-800 text-sm">Payment will be recorded on save</p>
                                    <p id="pay-summary-text" class="text-green-700 text-xs mt-0.5"></p>
                                </div>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-green-600 text-white text-xs font-bold">PAID</span>
                        </div>
                    </div>
                </div>

            </div>

            <div id="detailsContainer"></div>
        }
    </div>

    @* ═══ LIST TAB ═══ *@
    <div id="content-list"
         class="@(activeTab == "list" ? "" : "hidden") shadow-lg rounded-2xl bg-white p-6 border">

        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-bold text-blue-900">
                <i class="fa-solid fa-list-ul mr-2"></i> Purchase Voucher List
            </h2>
            <div class="flex items-center space-x-4">
                <div class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-blue-900 shadow-md">
                    Total Items: @totalItems
                </div>
                <button type="button" id="btn-add-new"
                        class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-green-600 hover:bg-green-700">
                    <i class="fa-solid fa-plus mr-1"></i> Add New
                </button>
            </div>
        </div>

        <div class="overflow-hidden border rounded-lg mt-6">
            <div class="max-h-96 overflow-y-auto">
                <table class="table-auto w-full text-sm">
                    <thead class="bg-gradient-to-r from-blue-800 to-blue-900 text-white sticky top-0">
                        <tr>
                            <th class="p-3">ID</th>
                            <th class="p-3">Date</th>
                            <th class="p-3">Vendor</th>
                            <th class="p-3">Type</th>
                            <th class="p-3">Remarks</th>
                            <th class="p-3">Total</th>
                            <th class="p-3">Net Amount</th>
                            <th class="p-3">Status</th>
                            <th class="p-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in purchaseList ?? new List<ERP.Models.PurchaseListDto>())
                        {
                            <tr class="hover:bg-gray-50 border-b">
                                <td class="p-3 font-semibold text-center">@item.Id</td>
                                <td class="p-3">@item.CurrentDate.ToString("dd-MMM-yyyy")</td>
                                <td class="p-3 font-medium">@(item.VenderName ?? "N/A")</td>
                                <td class="p-3">
                                    <span class="px-2 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                                        @item.Etype
                                    </span>
                                </td>
                                <td class="p-3 text-gray-500">@(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)</td>
                                <td class="p-3 text-right text-blue-700">@item.TotalAmount.ToString("F2")</td>
                                <td class="p-3 text-right text-green-700 font-semibold">@item.NetAmount.ToString("F2")</td>
                                <td class="p-3 text-center">
                                    @{
                                        var ps = item.PaymentStatus ?? "Unpaid";
                                    }
                                    @if (ps == "Paid")
                                    {
                                        <span class="px-2 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">
                                            <i class="fa-solid fa-check mr-1"></i>Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-full text-xs font-bold bg-orange-100 text-orange-700">
                                            <i class="fa-solid fa-clock mr-1"></i>Unpaid
                                        </span>
                                    }
                                </td>
                                <td class="p-3 space-x-1 text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       asp-route-page="@currentPage" asp-route-pageSize="@pageSize"
                                       class="px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-100 text-blue-700 hover:bg-blue-200">
                                        <i class="fa-solid fa-edit mr-1"></i> Edit
                                    </a>
                                    <a href="javascript:void(0)"
                                       onclick="window.open('/PurchaseVoucher/PrintSalesReturnVoucher?id=@item.Id','_blank')"
                                       class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-600 text-white hover:bg-blue-700">
                                        <i class="fa-solid fa-print mr-1"></i> Print
                                    </a>
                                    @using (Html.BeginForm("Delete", "PurchaseVoucher", FormMethod.Post,
                                        new { onsubmit = "return confirm('Are you sure you want to delete this voucher?');", @class = "inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", item.Id)
                                        <button type="submit"
                                                class="px-3 py-1.5 rounded-lg text-xs font-medium bg-red-100 text-red-700 hover:bg-red-200">
                                            <i class="fa-solid fa-trash mr-1"></i> Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!(purchaseList?.Any() ?? false))
                        {
                            <tr>
                                <td colspan="9" class="p-8 text-center text-gray-400">
                                    <i class="fa-solid fa-inbox fa-2x mb-2 block"></i>
                                    No purchase vouchers found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="flex justify-between items-center mt-4 text-sm text-gray-600">
            <div>
                @if (totalItems > 0) { <span>Showing @startItem to @endItem of @totalItems entries</span> }
                else { <span>No entries found</span> }
            </div>
            <div class="flex space-x-2">
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("PurchaseVoucher", new { page = currentPage - 1, pageSize, activeTab = "list" })"
                       class="px-3 py-1 rounded bg-blue-600 text-white hover:bg-blue-700">&laquo; Previous</a>
                }
                @if (endItem < totalItems)
                {
                    <a href="@Url.Action("PurchaseVoucher", new { page = currentPage + 1, pageSize, activeTab = "list" })"
                       class="px-3 py-1 rounded bg-blue-600 text-white hover:bg-blue-700">Next &raquo;</a>
                }
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_VenderModal",      new ERP.Models.Vender())
@await Html.PartialAsync("_TransporterModal", new ERP.Models.Transporter())
@await Html.PartialAsync("_WarehouseModal",   new ERP.Models.Warehouse())
<div id="itemModalContainer"></div>

<script>
const TAX_LIST = @Html.Raw(taxJson);

// ════════════════════════════════════════════════════════════════
// MODALS
// ════════════════════════════════════════════════════════════════
function openVenderModal()       { document.getElementById('venderModal').classList.remove('hidden'); }
function closeVenderModal()      { document.getElementById('venderModal').classList.add('hidden'); }
function openTransporterModal()  { document.getElementById('transporterModal').classList.remove('hidden'); }
function closeTransporterModal() { document.getElementById('transporterModal').classList.add('hidden'); }
function openWarehouseModal()    { document.getElementById('warehouseModal').classList.remove('hidden'); }
function closeWarehouseModal()   { document.getElementById('warehouseModal').classList.add('hidden'); }

function openItemModal() {
    fetch('/PurchaseVoucher/ItemModal')
        .then(r => r.text())
        .then(html => {
            document.getElementById('itemModalContainer').innerHTML = html;
            document.getElementById('itemModal').classList.remove('hidden');
        })
        .catch(err => console.error('Item modal load failed:', err));
}
function closeItemModal() { document.getElementById('itemModalContainer').innerHTML = ''; }

// ════════════════════════════════════════════════════════════════
// MAIN TAB SWITCHING
// ════════════════════════════════════════════════════════════════
const tabForm     = document.getElementById('tab-form');
const tabList     = document.getElementById('tab-list');
const contentForm = document.getElementById('content-form');
const contentList = document.getElementById('content-list');
const btnAddNew   = document.getElementById('btn-add-new');

tabForm.addEventListener('click',  () => showTab('form'));
tabList.addEventListener('click',  () => showTab('list'));
if (btnAddNew) btnAddNew.addEventListener('click', addNew);

function showTab(tab) {
    if (tab === 'form') {
        tabForm.classList.add('text-blue-900','border-b-2','border-blue-900');
        tabForm.classList.remove('text-gray-500');
        tabList.classList.remove('text-blue-900','border-b-2','border-blue-900');
        tabList.classList.add('text-gray-500');
        contentForm.classList.remove('hidden');
        contentList.classList.add('hidden');
    } else {
        tabList.classList.add('text-blue-900','border-b-2','border-blue-900');
        tabList.classList.remove('text-gray-500');
        tabForm.classList.remove('text-blue-900','border-b-2','border-blue-900');
        tabForm.classList.add('text-gray-500');
        contentList.classList.remove('hidden');
        contentForm.classList.add('hidden');
    }
}

function addNew() {
    resetForm();
    document.getElementById('StockMasterId').value = '0';
    showTab('form');
}

function resetForm() {
    document.querySelector('form')?.reset();
    details = [];
    renderTable();
    clearInputs();
    updateNetAmount();
    onPaymentMethodChange(); // payment fields reset
    showDetailTab('stock-details');
}

// ════════════════════════════════════════════════════════════════
// DETAIL TAB SWITCHING
// ════════════════════════════════════════════════════════════════
const tabStockDetails          = document.getElementById('tab-stock-details');
const tabAdditionalCharges     = document.getElementById('tab-additional-charges');
const tabPaymentBtn            = document.getElementById('tab-payment');
const contentStockDetails      = document.getElementById('content-stock-details');
const contentAdditionalCharges = document.getElementById('content-additional-charges');
const contentPayment           = document.getElementById('content-payment');

tabStockDetails.addEventListener('click',      () => showDetailTab('stock-details'));
tabAdditionalCharges.addEventListener('click', () => showDetailTab('additional-charges'));
tabPaymentBtn.addEventListener('click',        () => showDetailTab('payment'));

function showDetailTab(tab) {
    [tabStockDetails, tabAdditionalCharges, tabPaymentBtn].forEach(t => {
        t.classList.remove('text-blue-900','border-b-2','border-blue-900');
        t.classList.add('text-gray-500');
    });
    [contentStockDetails, contentAdditionalCharges, contentPayment].forEach(c => c.classList.add('hidden'));

    if (tab === 'stock-details') {
        tabStockDetails.classList.add('text-blue-900','border-b-2','border-blue-900');
        tabStockDetails.classList.remove('text-gray-500');
        contentStockDetails.classList.remove('hidden');
    } else if (tab === 'additional-charges') {
        tabAdditionalCharges.classList.add('text-blue-900','border-b-2','border-blue-900');
        tabAdditionalCharges.classList.remove('text-gray-500');
        contentAdditionalCharges.classList.remove('hidden');
    } else if (tab === 'payment') {
        tabPaymentBtn.classList.add('text-blue-900','border-b-2','border-blue-900');
        tabPaymentBtn.classList.remove('text-gray-500');
        contentPayment.classList.remove('hidden');
    }
}

// ════════════════════════════════════════════════════════════════
// PAYMENT METHOD CONDITIONAL SHOW / HIDE
// Cash   → Amount + Method
// Cheque → Amount + Method + Bank Account + Cheque No + Cheque Date
// Bank   → Amount + Method + Bank Account
// None   → sab hide
// ════════════════════════════════════════════════════════════════
function onPaymentMethodChange() {
    const method = document.getElementById('paymentMethod')?.value || '';

    const amtCol        = document.getElementById('pay-amount-col');
    const bankCol       = document.getElementById('pay-bank-col');
    const chequeNoCol   = document.getElementById('pay-cheque-no-col');
    const chequeDateCol = document.getElementById('pay-cheque-date-col');
    const summaryCard   = document.getElementById('pay-summary-card');
    const summaryText   = document.getElementById('pay-summary-text');

    // Pehle sab hide karo
    [amtCol, bankCol, chequeNoCol, chequeDateCol].forEach(el => {
        if (el) el.style.display = 'none';
    });
    if (summaryCard) summaryCard.classList.add('hidden');

    if (method === 'Cash') {
        // Cash: Amount only
        amtCol.style.display = '';
        if (summaryCard) {
            summaryCard.classList.remove('hidden');
            summaryText.textContent = 'Cash payment — amount required';
        }
    } else if (method === 'Cheque') {
        // Cheque: Amount + Bank Account + Cheque No + Cheque Date
        amtCol.style.display        = '';
        bankCol.style.display       = '';
        chequeNoCol.style.display   = '';
        chequeDateCol.style.display = '';
        if (summaryCard) {
            summaryCard.classList.remove('hidden');
            summaryText.textContent = 'Cheque payment — bank account, cheque no & date required';
        }
    } else if (method === 'Bank') {
        // Bank: Amount + Bank Account
        amtCol.style.display  = '';
        bankCol.style.display = '';
        if (summaryCard) {
            summaryCard.classList.remove('hidden');
            summaryText.textContent = 'Bank transfer — select bank account';
        }
    }
    // None: sab hidden (already done above)
}

// ════════════════════════════════════════════════════════════════
// FETCH PURCHASE RATE
// ════════════════════════════════════════════════════════════════
function fetchPurchaseRate() {
    const itemId = document.getElementById('itemId').value;
    if (!itemId) { document.getElementById('rate').value = ''; calculateAmounts(); return; }
    fetch(`@Url.Action("GetPurchaseRate", "PurchaseVoucher")?itemId=${itemId}`)
        .then(r => r.json())
        .then(data => {
            document.getElementById('rate').value = data.purchaseRate ? parseFloat(data.purchaseRate).toFixed(2) : '';
            calculateAmounts();
        })
        .catch(() => { document.getElementById('rate').value = ''; calculateAmounts(); });
}

// ════════════════════════════════════════════════════════════════
// PRINT
// ════════════════════════════════════════════════════════════════
function printVoucher() {
    const id = document.getElementById('StockMasterId').value;
    if (parseInt(id) > 0) {
        window.open('/PurchaseVoucher/PrintSalesReturnVoucher?id=' + id, '_blank');
    } else {
        alert('Please save the voucher first before printing.');
    }
}

// ════════════════════════════════════════════════════════════════
// INPUT REFERENCES
// ════════════════════════════════════════════════════════════════
const qtyInput         = document.getElementById('qty');
const rateInput        = document.getElementById('rate');
const amountInput      = document.getElementById('amount');
const discountPerInput = document.getElementById('discount_percentage');
const discountAmtInput = document.getElementById('discount_amount');
const netAmtInput      = document.getElementById('net_amount');
const gstInput         = document.getElementById('gst');
const gstAmtInput      = document.getElementById('gst_amount');
const inclTaxInput     = document.getElementById('incl_Tax_Amount');
const taxSetupSelect   = document.getElementById('taxSetupId');
const gstPctCol        = document.getElementById('gst-pct-col');
const gstAmtCol        = document.getElementById('gst-amt-col');

// ════════════════════════════════════════════════════════════════
// TAX SETUP CHANGE
// ════════════════════════════════════════════════════════════════
function onTaxSetupChange() {
    const selectedOption = taxSetupSelect.selectedOptions[0];
    const pct = selectedOption ? parseFloat(selectedOption.dataset.percentage) || 0 : 0;
    if (pct > 0) {
        gstPctCol.style.display = '';
        gstAmtCol.style.display = '';
        gstInput.value = pct.toFixed(2);
    } else {
        gstPctCol.style.display = 'none';
        gstAmtCol.style.display = 'none';
        gstInput.value    = '0';
        gstAmtInput.value = '0.00';
    }
    calculateGST();
}

// ════════════════════════════════════════════════════════════════
// CALCULATION CHAIN
// ════════════════════════════════════════════════════════════════
qtyInput.addEventListener('input',         calculateAmounts);
rateInput.addEventListener('input',        calculateAmounts);
discountPerInput.addEventListener('input', calculateDiscount);

function calculateAmounts() {
    const qty    = parseFloat(qtyInput.value)  || 0;
    const rate   = parseFloat(rateInput.value) || 0;
    const amount = qty * rate;

    amountInput.value      = amount.toFixed(2);
    discountPerInput.value = '';
    discountAmtInput.value = '0.00';
    netAmtInput.value      = amount.toFixed(2);

    const pct = parseFloat(gstInput.value) || 0;
    if (pct > 0) { calculateGST(); }
    else { gstAmtInput.value = '0.00'; inclTaxInput.value = amount.toFixed(2); }
}

function calculateDiscount() {
    const amount = parseFloat(amountInput.value)      || 0;
    const per    = parseFloat(discountPerInput.value) || 0;
    const disc   = (amount * per) / 100;
    const net    = amount - disc;
    discountAmtInput.value = disc.toFixed(2);
    netAmtInput.value      = net.toFixed(2);
    calculateGST();
}

function calculateGST() {
    const netAmt  = parseFloat(netAmtInput.value) || 0;
    const gstPer  = parseFloat(gstInput.value)    || 0;
    const gstAmt  = (netAmt * gstPer) / 100;
    const inclTax = netAmt + gstAmt;
    gstAmtInput.value  = gstAmt.toFixed(2);
    inclTaxInput.value = inclTax.toFixed(2);
}

// ════════════════════════════════════════════════════════════════
// ADD DETAIL ROW
// ════════════════════════════════════════════════════════════════
let details = [];

document.getElementById('btnAddDetail').addEventListener('click', () => {
    const warehouseId   = document.getElementById('warehouseId').value;
    const warehouseName = document.getElementById('warehouseId').selectedOptions[0]?.text || '';
    const itemId        = document.getElementById('itemId').value;
    const itemName      = document.getElementById('itemId').selectedOptions[0]?.text || '';
    const taxSetupId    = taxSetupSelect.value ? parseInt(taxSetupSelect.value) : null;
    const taxName       = taxSetupSelect.value ? (taxSetupSelect.selectedOptions[0]?.text || '') : 'No Tax';

    const qty                 = parseFloat(qtyInput.value)         || 0;
    const rate                = parseFloat(rateInput.value)        || 0;
    const amount              = parseFloat(amountInput.value)      || 0;
    const discount_percentage = parseFloat(discountPerInput.value) || 0;
    const discount_amount     = parseFloat(discountAmtInput.value) || 0;
    const net_amount          = parseFloat(netAmtInput.value)      || 0;
    const gst                 = parseFloat(gstInput.value)         || 0;
    const gst_amount          = parseFloat(gstAmtInput.value)      || 0;
    const incl_Tax_Amount     = parseFloat(inclTaxInput.value)     || 0;
    const currentDate         = document.querySelector('input[name="StockMaster.current_date"]')?.value || '';

    if (!warehouseId) { showAddMessage('Please select a warehouse.', false); return; }
    if (!itemId)      { showAddMessage('Please select an item.', false); return; }
    if (qty  <= 0)    { showAddMessage('Quantity must be greater than 0.', false); return; }
    if (rate <= 0)    { showAddMessage('Rate must be greater than 0.', false); return; }

    details.push({ warehouseId, warehouseName, itemId, itemName, taxSetupId, taxName,
        qty, rate, amount, discount_percentage, discount_amount,
        net_amount, gst, gst_amount, incl_Tax_Amount, current_date: currentDate });

    renderTable();
    clearInputs();
    updateNetAmount();
    showAddMessage(`'${itemName}' added successfully.`, true);
});

function showAddMessage(msg, isSuccess) {
    const div = document.getElementById('addMessage');
    div.className = `mt-2 px-4 py-2 rounded-lg text-sm font-semibold ${
        isSuccess ? 'bg-green-100 text-green-700 border border-green-300'
                  : 'bg-red-100 text-red-700 border border-red-300'}`;
    div.innerHTML = `<i class="fa-solid ${isSuccess ? 'fa-circle-check' : 'fa-circle-xmark'} mr-2"></i>${msg}`;
    div.classList.remove('hidden');
    setTimeout(() => div.classList.add('hidden'), 4000);
}

// ════════════════════════════════════════════════════════════════
// RENDER TABLE + HIDDEN INPUTS
// ════════════════════════════════════════════════════════════════
function renderTable() {
    const tbody     = document.querySelector('#detailsTable tbody');
    const container = document.getElementById('detailsContainer');
    tbody.innerHTML     = '';
    container.innerHTML = '';

    let totalAmount = 0, totalDiscount = 0, totalNet = 0, totalGstAmt = 0, totalInclTax = 0;

    details.forEach((d, i) => {
        totalAmount   += d.amount;
        totalDiscount += d.discount_amount;
        totalNet      += d.net_amount;
        totalGstAmt   += d.gst_amount;
        totalInclTax  += d.incl_Tax_Amount;

        const gstCols = d.gst > 0
            ? `<td class="p-3 text-center text-purple-700">${d.gst.toFixed(2)}%</td>
               <td class="p-3 text-right text-purple-700">${d.gst_amount.toFixed(2)}</td>`
            : `<td class="p-3 text-center text-gray-400">-</td>
               <td class="p-3 text-center text-gray-400">-</td>`;

        tbody.innerHTML += `
            <tr class="hover:bg-gray-50 border-b">
                <td class="p-3 text-center">${i + 1}</td>
                <td class="p-3">${d.current_date}</td>
                <td class="p-3">${d.warehouseName}</td>
                <td class="p-3 font-medium">${d.itemName}</td>
                <td class="p-3 text-center">${d.qty}</td>
                <td class="p-3 text-right">${d.rate.toFixed(2)}</td>
                <td class="p-3 text-right">${d.amount.toFixed(2)}</td>
                <td class="p-3 text-center">${d.discount_percentage.toFixed(2)}</td>
                <td class="p-3 text-right text-orange-600">${d.discount_amount.toFixed(2)}</td>
                <td class="p-3 text-right text-blue-700">${d.net_amount.toFixed(2)}</td>
                <td class="p-3 text-center text-xs font-semibold">${d.taxName}</td>
                ${gstCols}
                <td class="p-3 text-right text-green-700 font-semibold">${d.incl_Tax_Amount.toFixed(2)}</td>
                <td class="p-3 text-center">
                    <button type="button" onclick="removeDetail(${i})"
                            class="px-3 py-1 rounded-lg text-xs font-medium bg-red-100 text-red-700 hover:bg-red-200">
                        <i class="fa-solid fa-trash mr-1"></i> Remove
                    </button>
                </td>
            </tr>`;

        container.innerHTML += `
            <input type="hidden" name="StockDetail[${i}].warehouseId"         value="${d.warehouseId}" />
            <input type="hidden" name="StockDetail[${i}].itemId"              value="${d.itemId}" />
            <input type="hidden" name="StockDetail[${i}].taxSetupId"          value="${d.taxSetupId ?? ''}" />
            <input type="hidden" name="StockDetail[${i}].qty"                 value="${d.qty}" />
            <input type="hidden" name="StockDetail[${i}].rate"                value="${d.rate}" />
            <input type="hidden" name="StockDetail[${i}].amount"              value="${d.amount}" />
            <input type="hidden" name="StockDetail[${i}].discount_percentage" value="${d.discount_percentage}" />
            <input type="hidden" name="StockDetail[${i}].discount_amount"     value="${d.discount_amount}" />
            <input type="hidden" name="StockDetail[${i}].net_amount"          value="${d.net_amount}" />
            <input type="hidden" name="StockDetail[${i}].gst"                 value="${d.gst}" />
            <input type="hidden" name="StockDetail[${i}].gst_amount"          value="${d.gst_amount}" />
            <input type="hidden" name="StockDetail[${i}].incl_Tax_Amount"     value="${d.incl_Tax_Amount}" />
            <input type="hidden" name="StockDetail[${i}].current_date"        value="${d.current_date}" />`;
    });

    if (details.length > 0) {
        tbody.innerHTML += `
            <tr class="bg-blue-50 font-semibold border-t-2 border-blue-200">
                <td colspan="6" class="p-3 text-right text-gray-700">Totals:</td>
                <td class="p-3 text-right">${totalAmount.toFixed(2)}</td>
                <td></td>
                <td class="p-3 text-right text-orange-600">${totalDiscount.toFixed(2)}</td>
                <td class="p-3 text-right text-blue-700">${totalNet.toFixed(2)}</td>
                <td></td>
                <td class="p-3 text-right text-purple-700">${totalGstAmt.toFixed(2)}</td>
                <td></td>
                <td class="p-3 text-right text-green-700">${totalInclTax.toFixed(2)}</td>
                <td></td>
            </tr>`;
    }

    const totalAmtInput = document.querySelector('input[name="StockMaster.total_amount"]');
    if (totalAmtInput) totalAmtInput.value = totalInclTax.toFixed(2);
    updateNetAmount();
}

function removeDetail(i) { details.splice(i, 1); renderTable(); }

function clearInputs() {
    ['warehouseId','itemId','qty','rate','amount','discount_percentage',
     'discount_amount','net_amount','gst','gst_amount','incl_Tax_Amount']
        .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
    taxSetupSelect.value    = '';
    gstPctCol.style.display = 'none';
    gstAmtCol.style.display = 'none';
}

function updateNetAmount() {
    const total = parseFloat(document.querySelector('input[name="StockMaster.total_amount"]')?.value)    || 0;
    const disc  = parseFloat(document.querySelector('input[name="StockMaster.discount_amount"]')?.value) || 0;
    const tax   = parseFloat(document.querySelector('input[name="StockMaster.tax_amount"]')?.value)      || 0;
    const net   = total - disc + tax;
    const netEl = document.querySelector('input[name="StockMaster.net_amount"]');
    if (netEl) netEl.value = net.toFixed(2);

     const payAmtEl = document.querySelector('input[name="PaymentVoucher.amount"]');
    if (payAmtEl) payAmtEl.value = net.toFixed(2);
}

function beforeSave() {
    if (details.length === 0) {
        alert('Please add at least one stock item before saving.');
        return false;
    }
    updateNetAmount();
    return true;
}

// ════════════════════════════════════════════════════════════════
// EDIT MODE: Pre-load existing details
// ════════════════════════════════════════════════════════════════
@if (Model.StockMaster.Id > 0 && Model.StockDetail?.Any() == true)
{
    var warehouses = ViewBag.Warehouses as IEnumerable<dynamic>;
    var items      = ViewBag.Items     as IEnumerable<dynamic>;
    var taxSetups  = ViewBag.TaxSetup  as IEnumerable<dynamic>;

    var warehouseDict = warehouses?.ToDictionary(w => (int)w.Id, w => (string)w.warehouse_name)
                        ?? new Dictionary<int, string>();
    var itemDict      = items?.ToDictionary(it => (int)it.Id, it => (string)it.item_name)
                        ?? new Dictionary<int, string>();
    var taxDict       = taxSetups?.ToDictionary(t => (int)t.Id, t => (string)t.tax_name)
                        ?? new Dictionary<int, string>();

    var jsonDetails = JsonSerializer.Serialize(Model.StockDetail.Select(d => new
    {
        warehouseId         = d.warehouseId,
        warehouseName       = warehouseDict.ContainsKey(d.warehouseId ?? 0) ? warehouseDict[d.warehouseId ?? 0] : "Unknown",
        itemId              = d.itemId,
        itemName            = itemDict.ContainsKey(d.itemId) ? itemDict[d.itemId] : "Unknown",
        taxSetupId          = d.taxSetupId,
        taxName             = d.taxSetupId.HasValue && taxDict.ContainsKey(d.taxSetupId.Value)
                              ? taxDict[d.taxSetupId.Value] : "No Tax",
        qty                 = d.qty,
        rate                = d.rate,
        amount              = d.amount,
        discount_percentage = d.discount_percentage ?? 0m,
        discount_amount     = d.discount_amount     ?? 0m,
        net_amount          = d.net_amount,
        gst                 = d.gst                 ?? 0m,
        gst_amount          = d.gst_amount          ?? 0m,
        incl_Tax_Amount     = d.incl_Tax_Amount     ?? 0m,
        current_date        = d.current_date.ToString("yyyy-MM-dd")
    }));

    <text>
    details = @Html.Raw(jsonDetails);
    renderTable();
    </text>
}

// Page load par MOP state restore karo (edit mode ke liye)
document.addEventListener('DOMContentLoaded', function () {
    onPaymentMethodChange();
});

showTab('@activeTab');
</script>
