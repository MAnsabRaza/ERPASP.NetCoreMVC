@model ERP.Models.PurchaseViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Stock Adjustment";
    var purchaseReturnList = ViewBag.PurchaseReturn as List<ERP.Models.PurchaseListDto>;

    int currentPage = (int)(ViewBag.Page ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 5);
    int totalItems = (int)(ViewBag.TotalItems ?? 0);
    string activeTab = ViewBag.ActiveTab as string ?? "form";

    int startItem = (currentPage - 1) * pageSize + 1;
    int endItem = Math.Min(currentPage * pageSize, totalItems);

    // Determine current etype for edit mode
    string currentEtype = Model.StockMaster.etype ?? "StockAdjustment_In";
    string activeDetailTab = currentEtype == "StockAdjustment_Out" ? "stock-out" : "stock-in";
}

<div class="space-y-8">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- MAIN TABS: Form / List                                -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div class="border-b border-gray-300 bg-white shadow-sm rounded-xl p-2">
        <nav class="flex space-x-6" aria-label="Tabs">
            <button id="tab-form"
                    class="px-4 py-2 text-sm font-semibold @(activeTab == "form" ? "text-blue-900 border-b-2 border-blue-900" : "text-gray-500 hover:text-blue-900")"
                    type="button">
                <i class="fa-solid fa-plus-circle mr-2"></i> Stock Adjustment Entry
            </button>
            <button id="tab-list"
                    class="px-4 py-2 text-sm font-semibold @(activeTab == "list" ? "text-blue-900 border-b-2 border-blue-900" : "text-gray-500 hover:text-blue-900")"
                    type="button">
                <i class="fa-solid fa-list mr-2"></i> Stock Adjustment List
            </button>
        </nav>
    </div>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- FORM TAB                                              -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div id="content-form" class="tab-content @(activeTab == "list" ? "hidden" : "")">
        @using (Html.BeginForm("Create", "AssembleDessamble", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.StockMaster.Id, new { id = "StockMasterId" })
            @Html.HiddenFor(m => m.StockMaster.companyId)
            @Html.HiddenFor(m => m.StockMaster.userId)

            <!-- etype hidden — JS will update this based on active tab -->
            <input type="hidden" id="etypeInput" name="StockMaster.etype" value="@currentEtype" />

            <!-- Header -->
            <div class="shadow-lg rounded-2xl bg-gradient-to-r from-blue-50 to-blue-100 p-6 border border-gray-200">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-2xl font-bold text-blue-800 flex items-center gap-2">
                            <i class="fa-solid fa-boxes text-blue-900"></i> Stock Adjustment
                        </h2>
                        <p class="text-gray-600 mt-1 text-sm">Stock In → Qty increase | Stock Out → Qty decrease</p>
                    </div>
                    <div class="space-x-2">
                        <button type="submit" onclick="beforeSave()"
                                class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-green-600 hover:bg-green-700 shadow-md transition">
                            <i class="fa-solid fa-save mr-2"></i> Save
                        </button>
                        <button type="reset"
                                class="px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 bg-yellow-300 hover:bg-yellow-400 shadow-md transition"
                                onclick="resetForm()">
                            <i class="fa-solid fa-rotate-right mr-2"></i> Reset
                        </button>
                    </div>
                </div>
            </div>

            <!-- Master Fields -->
            <div class="shadow-md rounded-2xl bg-white p-6 border border-gray-200 mt-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Current Date <sup class="text-red-800 text-lg">*</sup></label>
                        @Html.TextBoxFor(m => m.StockMaster.current_date, "{0:yyyy-MM-dd}",
                        new { @class = "w-full p-2 border rounded-lg", type = "date", required = "required" })
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Due Date <sup class="text-red-800 text-lg">*</sup></label>
                    @Html.TextBoxFor(m => m.StockMaster.due_date, "{0:yyyy-MM-dd}",
                                        new { @class = "w-full p-2 border rounded-lg", type = "date", required = "required" })
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Posted Date <sup class="text-red-800 text-lg">*</sup></label>
                    @Html.TextBoxFor(m => m.StockMaster.posted_date, "{0:yyyy-MM-dd}",
                                        new { @class = "w-full p-2 border rounded-lg", type = "date", required = "required" })
                </div>
                <div class="md:col-span-3">
                    <label class="block font-semibold text-gray-700 mb-1">Remarks</label>
                    @Html.TextAreaFor(m => m.StockMaster.remarks,
                                        new { @id = "remarksInput", @class = "w-full p-2 border rounded-lg", rows = "2", placeholder = "Enter Remarks e.g. Damage, Extra Stock Found..." })
                     </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════ -->
        <!-- STOCK IN / STOCK OUT TABS                     -->
        <!-- ══════════════════════════════════════════════ -->
        <div class="shadow-md rounded-2xl bg-white p-6 border mt-4">

            <nav class="flex space-x-2 mb-6" aria-label="Stock Tabs">
                <!-- STOCK IN TAB -->
                <button id="tab-stock-in" type="button"
                        onclick="switchStockTab('stock-in')"
                        class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition
                                   @(activeDetailTab == "stock-in"
                                                               ? "bg-green-600 text-white shadow-md"
                                                               : "bg-gray-100 text-gray-600 hover:bg-green-50 hover:text-green-700")">
                                                                                                                                <i class="fa-solid fa-arrow-up"></i>
                                                                                                                                Stock In
                                                                                                                                <span class="ml-1 px-2 py-0.5 rounded-full text-xs font-bold
                                                                                                                                                 @(activeDetailTab == "stock-in" ? "bg-white text-green-700" : "bg-green-100 text-green-700")">
                                                                                                                                    +QTY
                                                                                                                                </span>
                                                                                                                            </button>

                <!-- STOCK OUT TAB -->
                <button id="tab-stock-out" type="button"
                        onclick="switchStockTab('stock-out')"
                        class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition
                                   @(activeDetailTab == "stock-out"
                                                               ? "bg-red-600 text-white shadow-md"
                                                               : "bg-gray-100 text-gray-600 hover:bg-red-50 hover:text-red-700")">
                    <i class="fa-solid fa-arrow-down"></i>
                    Stock Out
                    <span class="ml-1 px-2 py-0.5 rounded-full text-xs font-bold
                                     @(activeDetailTab == "stock-out" ? "bg-white text-red-700" : "bg-red-100 text-red-700")">
                        -QTY
                    </span>
                </button>

                    <!-- Active Mode Badge -->
                    <div id="activeBadge" class="ml-auto flex items-center">
                        <!-- JS will update this -->
                    </div>
                </nav>

                <!-- Info Banner — changes with tab -->
                <div id="stockInfoBanner" class="mb-4 px-4 py-3 rounded-lg text-sm font-semibold border"></div>

                <!-- ── ITEM INPUT SECTION ── -->
                <h3 class="text-lg font-semibold mb-4 text-gray-700">Add Items</h3>
                <div class="grid grid-cols-12 gap-4 items-end">
                    <div class="col-span-3">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">
                            Warehouse <sup class="text-red-600">*</sup>
                            <a href="javascript:void(0)" onclick="openWarehouseModal()"
                               class="ml-1 text-xs text-blue-600 font-semibold hover:text-blue-800">
                                <i class="fa-solid fa-plus mr-1"></i>Add
                            </a>
                        </label>
                        <select id="warehouseId" class="w-full p-2 border rounded-lg">
                            <option value="">Select Warehouse</option>
                        @foreach (var warehouse in ViewBag.Warehouses as IEnumerable<dynamic>)
                            {
                                <option value="@warehouse.Id">@warehouse.warehouse_name</option>
                            }
                        </select>
                    </div>

                    <div class="col-span-4">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">
                            Item <sup class="text-red-600">*</sup>
                            <a href="javascript:void(0)" onclick="openItemModal()"
                               class="ml-1 text-xs text-blue-600 font-semibold hover:text-blue-800">
                                <i class="fa-solid fa-plus mr-1"></i>Add
                            </a>
                        </label>
                        <select id="itemId" class="w-full p-2 border rounded-lg" onchange="fetchPurchaseRate()">
                            <option value="">Select Item</option>
                            @foreach (var item in ViewBag.Items as IEnumerable<dynamic>)
                            {
                                <option value="@item.Id" data-qty="@item.qty">@item.item_name</option>
                            }
                        </select>
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">
                            Stock Qty
                        </label>
                        <input type="number" id="currentStockQty" readonly
                               class="w-full p-2 border rounded-lg bg-gray-50 text-gray-500 font-semibold"
                               placeholder="0" />
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Rate <sup class="text-red-600">*</sup></label>
                        <input type="number" id="rate" class="w-full p-2 border rounded-lg" step="0.01" min="0" />
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Qty <sup class="text-red-600">*</sup></label>
                        <input type="number" id="qty" class="w-full p-2 border rounded-lg" min="1" />
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Amount</label>
                        <input type="number" id="amount" class="w-full p-2 border rounded-lg bg-gray-50" step="0.01" readonly />
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Discount %</label>
                        <input type="number" id="discount_percentage" class="w-full p-2 border rounded-lg" step="0.01" min="0" />
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Disc Amt</label>
                        <input type="number" id="discount_amount" readonly class="w-full p-2 border rounded-lg bg-gray-50" step="0.01" />
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Net Amount</label>
                        <input type="number" id="net_amount" readonly class="w-full p-2 border rounded-lg bg-gray-50" step="0.01" />
                    </div>

                    <div class="col-span-2">
                        <button type="button" id="btnAddDetail"
                                class="w-full px-4 py-2 rounded-xl text-sm font-semibold text-white bg-blue-900 hover:bg-blue-800 transition">
                            <i class="fa-solid fa-plus mr-1"></i> Add
                        </button>
                    </div>
                </div>

                <!-- Toast -->
                <div id="toastArea" class="mt-3"></div>

                <!-- Details Table -->
                <div class="overflow-hidden border rounded-lg mt-6">
                    <div class="max-h-96 overflow-y-auto">
                        <table class="table-auto w-full text-sm" id="detailsTable">
                            <thead class="bg-gradient-to-r from-blue-800 to-blue-900 text-white">
                                <tr>
                                    <th class="p-3">S.No</th>
                                    <th class="p-3">Date</th>
                                    <th class="p-3">Warehouse</th>
                                    <th class="p-3">Item</th>
                                    <th class="p-3">Stock Qty</th>
                                    <th class="p-3">Adj Qty</th>
                                    <th class="p-3">Rate</th>
                                    <th class="p-3">Amount</th>
                                    <th class="p-3">Dis%</th>
                                    <th class="p-3">Dis Amt</th>
                                    <th class="p-3">Net Amt</th>
                                    <th class="p-3">Type</th>
                                    <th class="p-3">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <!-- Totals -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mt-6 border-t pt-4">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Total Amount</label>
                        @Html.TextBoxFor(m => m.StockMaster.total_amount,
                        new { @class = "w-full p-2 border rounded-lg bg-gray-50", type = "number", step = "0.01", @readonly = "readonly" })
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Discount Amount</label>
                    @Html.TextBoxFor(m => m.StockMaster.discount_amount,
                                        new { @class = "w-full p-2 border rounded-lg", type = "number", step = "0.01", @onchange = "updateNetAmount()" })
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Tax Amount</label>
                    @Html.TextBoxFor(m => m.StockMaster.tax_amount,
                                        new { @class = "w-full p-2 border rounded-lg", type = "number", step = "0.01", @onchange = "updateNetAmount()" })
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Net Amount</label>
                    @Html.TextBoxFor(m => m.StockMaster.net_amount,
                                        new { @class = "w-full p-2 border rounded-lg bg-gray-50 font-bold text-green-700", type = "number", step = "0.01", @readonly = "readonly" })
                </div>
            </div>
        </div>

        <!-- Hidden inputs for StockDetail -->
        <div id="detailsContainer"></div>
                }
    </div>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LIST TAB                                              -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div id="content-list" class="tab-content @(activeTab == "list" ? "" : "hidden") shadow-lg rounded-2xl bg-white p-6 border">
        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-bold text-blue-900">
                <i class="fa-solid fa-list-ul"></i> Stock Adjustment List
            </h2>
            <div class="flex items-center space-x-4">
                <div class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-blue-900 shadow-md">
                    Total: @totalItems
                </div>
                <button type="button" id="btn-add-new"
                        class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-green-600 hover:bg-green-700">
                    <i class="fa-solid fa-plus"></i> Add New
                </button>
            </div>
        </div>

        <div class="overflow-hidden border rounded-lg mt-6">
            <div class="max-h-96 overflow-y-auto">
                <table class="table-auto w-full text-sm">
                    <thead class="bg-gradient-to-r from-blue-800 to-blue-900 text-white">
                        <tr>
                            <th class="p-3">ID</th>
                            <th class="p-3">Date</th>
                            <th class="p-3">Type</th>
                            <th class="p-3">Remarks</th>
                            <th class="p-3">Total</th>
                            <th class="p-3">Net</th>
                            <th class="p-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in purchaseReturnList ?? new List<ERP.Models.PurchaseListDto>())
                        {
                            bool isIn = item.Etype == "StockAdjustment_In";
                            <tr class="hover:bg-gray-50">
                                <td class="p-3 font-semibold">@item.Id</td>
                                <td class="p-3">@item.CurrentDate.ToString("dd-MMM-yyyy")</td>
                                <td class="p-3">
                                    @if (isIn)
                                    {
                                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800">
                                            <i class="fa-solid fa-arrow-up mr-1"></i> Stock In
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800">
                                            <i class="fa-solid fa-arrow-down mr-1"></i> Stock Out
                                        </span>
                                    }
                                </td>
                                <td class="p-3 text-gray-500">@(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)</td>
                                <td class="p-3 text-right text-blue-700">@item.TotalAmount.ToString("F2")</td>
                                <td class="p-3 text-right text-green-700 font-semibold">@item.NetAmount.ToString("F2")</td>
                                <td class="p-3 text-center space-x-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       asp-route-page="@currentPage"
                                       asp-route-pageSize="@pageSize"
                                       asp-route-activeTab="form"
                                       class="px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-100 text-blue-700 hover:bg-blue-200">
                                        <i class="fa-solid fa-edit mr-1"></i> Edit
                                    </a>
                                    @using (Html.BeginForm("Delete", "AssembleDessamble", FormMethod.Post,
                                                                    new { onsubmit = "return confirm('Delete this record?');", @class = "inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", item.Id)
                                        <button type="submit"
                                                class="px-3 py-1 rounded bg-red-100 text-red-700 hover:bg-red-200 text-xs font-medium">
                                            <i class="fa-solid fa-trash mr-1"></i> Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div class="flex justify-between items-center mt-4 text-sm text-gray-600">
            <div>Showing @startItem to @endItem of @totalItems entries</div>
            <div class="flex space-x-2">
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("AssembleDessamble", new { page = currentPage - 1, pageSize, activeTab = "list" })"
                       class="px-3 py-1 rounded bg-blue-600 text-white hover:bg-blue-700">Previous</a>
                }
                @if (endItem < totalItems)
                {
                    <a href="@Url.Action("AssembleDessamble", new { page = currentPage + 1, pageSize, activeTab = "list" })"
                       class="px-3 py-1 rounded bg-blue-600 text-white hover:bg-blue-700">Next</a>
                }
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_WarehouseModal", new ERP.Models.Warehouse())
<div id="itemModalContainer"></div>

<script>
    // ═══════════════════════════════════════════════════
    // STOCK IN / STOCK OUT TAB SWITCHING
    // ═══════════════════════════════════════════════════

    let currentStockTab = '@activeDetailTab'; // 'stock-in' or 'stock-out'
    let details = [];

    function switchStockTab(tab) {

        // If there are already added rows, confirm switch
        if (details.length > 0) {
            if (!confirm('Switching tab will clear existing rows. Continue?')) return;
            details = [];
            renderTable();
            updateNetAmount();
        }

        currentStockTab = tab;

        const btnIn  = document.getElementById('tab-stock-in');
        const btnOut = document.getElementById('tab-stock-out');

        if (tab === 'stock-in') {
            // Active: green
            btnIn.className  = 'flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition bg-green-600 text-white shadow-md';
            btnOut.className = 'flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition bg-gray-100 text-gray-600 hover:bg-red-50 hover:text-red-700';

            document.getElementById('etypeInput').value = 'StockAdjustment_In';
            document.getElementById('stockInfoBanner').className =
                'mb-4 px-4 py-3 rounded-lg text-sm font-semibold border bg-green-50 text-green-800 border-green-300';
            document.getElementById('stockInfoBanner').innerHTML =
                '<i class="fa-solid fa-arrow-up mr-2"></i><strong>Stock In Mode:</strong> Qty will be <strong>ADDED (+)</strong> to Item stock. Journal: Inventory DEBIT | COGS CREDIT';
        } else {
            // Active: red
            btnOut.className = 'flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition bg-red-600 text-white shadow-md';
            btnIn.className  = 'flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition bg-gray-100 text-gray-600 hover:bg-green-50 hover:text-green-700';

            document.getElementById('etypeInput').value = 'StockAdjustment_Out';
            document.getElementById('stockInfoBanner').className =
                'mb-4 px-4 py-3 rounded-lg text-sm font-semibold border bg-red-50 text-red-800 border-red-300';
            document.getElementById('stockInfoBanner').innerHTML =
                '<i class="fa-solid fa-arrow-down mr-2"></i><strong>Stock Out Mode:</strong> Qty will be <strong>REDUCED (-)</strong> from Item stock. Journal: COGS DEBIT | Inventory CREDIT';
        }
    }

    // Initialize on page load
    switchStockTab(currentStockTab);

    // ═══════════════════════════════════════════════════
    // MAIN TABS
    // ═══════════════════════════════════════════════════
    const tabForm    = document.getElementById("tab-form");
    const tabList    = document.getElementById("tab-list");
    const contentForm = document.getElementById("content-form");
    const contentList = document.getElementById("content-list");
    const btnAddNew  = document.getElementById("btn-add-new");

    tabForm.addEventListener("click", () => showTab("form"));
    tabList.addEventListener("click", () => showTab("list"));
    if (btnAddNew) btnAddNew.addEventListener("click", addNew);

    function showTab(tab) {
        if (tab === "form") {
            tabForm.classList.add("text-blue-900", "border-b-2", "border-blue-900");
            tabForm.classList.remove("text-gray-500");
            tabList.classList.remove("text-blue-900", "border-b-2", "border-blue-900");
            tabList.classList.add("text-gray-500");
            contentForm.classList.remove("hidden");
            contentList.classList.add("hidden");
        } else {
            tabList.classList.add("text-blue-900", "border-b-2", "border-blue-900");
            tabList.classList.remove("text-gray-500");
            tabForm.classList.remove("text-blue-900", "border-b-2", "border-blue-900");
            tabForm.classList.add("text-gray-500");
            contentList.classList.remove("hidden");
            contentForm.classList.add("hidden");
        }
    }

    function addNew() {
        resetForm();
        document.getElementById("StockMasterId").value = "0";
        showTab("form");
    }

    function resetForm() {
        document.querySelector("form").reset();
        details = [];
        renderTable();
        clearInputs();
        updateNetAmount();
        switchStockTab('stock-in');
    }

    // ═══════════════════════════════════════════════════
    // FETCH RATE
    // ═══════════════════════════════════════════════════
    function fetchPurchaseRate() {
        const itemSelect = document.getElementById("itemId");
        const itemId = itemSelect.value;
        const rateInput = document.getElementById("rate");
        const stockQtyInput = document.getElementById("currentStockQty");

        if (!itemId) {
            rateInput.value = "";
            stockQtyInput.value = "";
            calculateAmounts();
            return;
        }

        // Show current stock qty from data attribute
        const selectedOption = itemSelect.options[itemSelect.selectedIndex];
        stockQtyInput.value = selectedOption.getAttribute('data-qty') || '0';

        fetch(`@Url.Action("GetPurchaseRate", "AssembleDessamble")?itemId=${itemId}`)
            .then(r => r.json())
            .then(data => {
                rateInput.value = data.purchaseRate ? data.purchaseRate.toFixed(2) : "";
                calculateAmounts();
            })
            .catch(() => {
                rateInput.value = "";
                calculateAmounts();
            });
    }

    // ═══════════════════════════════════════════════════
    // CALCULATIONS
    // ═══════════════════════════════════════════════════
    const qtyInput          = document.getElementById("qty");
    const rateInput         = document.getElementById("rate");
    const amountInput       = document.getElementById("amount");
    const discountPerInput  = document.getElementById("discount_percentage");
    const discountAmtInput  = document.getElementById("discount_amount");
    const netAmtInput       = document.getElementById("net_amount");

    qtyInput.addEventListener("input", calculateAmounts);
    rateInput.addEventListener("input", calculateAmounts);
    discountPerInput.addEventListener("input", calculateDiscount);

    function calculateAmounts() {
        const qty    = parseFloat(qtyInput.value) || 0;
        const rate   = parseFloat(rateInput.value) || 0;
        const amount = qty * rate;
        amountInput.value       = amount.toFixed(2);
        discountPerInput.value  = "";
        discountAmtInput.value  = "";
        netAmtInput.value       = amount.toFixed(2);
    }

    function calculateDiscount() {
        const amount = parseFloat(amountInput.value) || 0;
        const per    = parseFloat(discountPerInput.value) || 0;
        const disc   = (amount * per) / 100;
        discountAmtInput.value = disc.toFixed(2);
        netAmtInput.value      = (amount - disc).toFixed(2);
    }

    // ═══════════════════════════════════════════════════
    // ADD DETAIL ROW
    // ═══════════════════════════════════════════════════
    document.getElementById("btnAddDetail").addEventListener("click", async () => {
        const warehouseId   = document.getElementById("warehouseId").value;
        const warehouseName = document.getElementById("warehouseId").selectedOptions[0]?.text;
        const itemId        = document.getElementById("itemId").value;
        const itemName      = document.getElementById("itemId").selectedOptions[0]?.text;
        const stockQty      = parseFloat(document.getElementById("currentStockQty").value) || 0;

        const qty               = parseFloat(qtyInput.value) || 0;
        const rate              = parseFloat(rateInput.value) || 0;
        const amount            = parseFloat(amountInput.value) || 0;
        const discount_percentage = parseFloat(discountPerInput.value) || 0;
        const discount_amount   = parseFloat(discountAmtInput.value) || 0;
        const net_amount        = parseFloat(netAmtInput.value) || 0;
        const currentDate       = document.querySelector('input[name="StockMaster.current_date"]').value;

        if (!warehouseId) { showToast("Please select a warehouse.", false); return; }
        if (!itemId)      { showToast("Please select an item.", false); return; }
        if (qty <= 0)     { showToast("Please enter a valid quantity.", false); return; }
        if (rate <= 0)    { showToast("Please enter a valid rate.", false); return; }

        // Stock Out: check available qty
        if (currentStockTab === 'stock-out') {
            if (stockQty <= 0) {
                showToast(`'${itemName}' has zero quantity in stock.`, false);
                return;
            }
            if (qty > stockQty) {
                showToast(`'${itemName}' available quantity is ${stockQty}. Cannot remove ${qty}.`, false);
                return;
            }
        }

        const btnAdd = document.getElementById("btnAddDetail");
        btnAdd.disabled = true;
        btnAdd.textContent = "Adding...";

        try {
            details.push({
                warehouseId, warehouseName,
                itemId, itemName,
                stockQty,
                qty, rate, amount,
                discount_percentage, discount_amount, net_amount,
                current_date: currentDate,
                adjType: currentStockTab  // 'stock-in' or 'stock-out'
            });

            renderTable();
            clearInputs();
            updateNetAmount();
            showToast(`'${itemName}' added as ${currentStockTab === 'stock-in' ? '✅ Stock In (+)' : '🔴 Stock Out (-)'}`, true);
        } finally {
            btnAdd.disabled = false;
            btnAdd.textContent = "Add";
            document.getElementById("btnAddDetail").innerHTML = '<i class="fa-solid fa-plus mr-1"></i> Add';
        }
    });

    // ═══════════════════════════════════════════════════
    // RENDER TABLE
    // ═══════════════════════════════════════════════════
    function renderTable() {
        const tbody     = document.querySelector("#detailsTable tbody");
        const container = document.getElementById("detailsContainer");
        tbody.innerHTML     = "";
        container.innerHTML = "";

        let totalAmount = 0, totalDiscount = 0, totalNet = 0;

        details.forEach((d, i) => {
            totalAmount   += d.amount;
            totalDiscount += d.discount_amount;
            totalNet      += d.net_amount;

            const isIn = d.adjType === 'stock-in';
            const typeBadge = isIn
                ? `<span class="px-2 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700"><i class="fa-solid fa-arrow-up mr-1"></i>IN</span>`
                : `<span class="px-2 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-700"><i class="fa-solid fa-arrow-down mr-1"></i>OUT</span>`;

            const displayQty = isIn ? `+${d.qty}` : `-${d.qty}`;
            const qtyClass   = isIn ? 'text-green-700 font-bold' : 'text-red-700 font-bold';

            tbody.innerHTML += `
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-3">${i + 1}</td>
                    <td class="p-3">${d.current_date}</td>
                    <td class="p-3">${d.warehouseName}</td>
                    <td class="p-3 font-medium">${d.itemName}</td>
                    <td class="p-3 text-gray-500">${d.stockQty}</td>
                    <td class="p-3 ${qtyClass}">${displayQty}</td>
                    <td class="p-3">${d.rate.toFixed(2)}</td>
                    <td class="p-3">${d.amount.toFixed(2)}</td>
                    <td class="p-3">${d.discount_percentage.toFixed(2)}</td>
                    <td class="p-3">${d.discount_amount.toFixed(2)}</td>
                    <td class="p-3 font-semibold">${d.net_amount.toFixed(2)}</td>
                    <td class="p-3">${typeBadge}</td>
                    <td class="p-3">
                        <button type="button" onclick="removeDetail(${i})"
                                class="text-red-600 hover:text-red-800 text-xs font-semibold">
                            <i class="fa-solid fa-trash mr-1"></i>Delete
                        </button>
                    </td>
                </tr>`;

            // Actual qty sent to server: positive for IN, negative for OUT
            const serverQty = isIn ? Math.abs(d.qty) : -Math.abs(d.qty);

            container.innerHTML += `
                <input type="hidden" name="StockDetail[${i}].warehouseId"          value="${d.warehouseId}" />
                <input type="hidden" name="StockDetail[${i}].itemId"                value="${d.itemId}" />
                <input type="hidden" name="StockDetail[${i}].qty"                   value="${serverQty}" />
                <input type="hidden" name="StockDetail[${i}].rate"                  value="${d.rate}" />
                <input type="hidden" name="StockDetail[${i}].amount"                value="${d.amount}" />
                <input type="hidden" name="StockDetail[${i}].discount_percentage"   value="${d.discount_percentage}" />
                <input type="hidden" name="StockDetail[${i}].discount_amount"       value="${d.discount_amount}" />
                <input type="hidden" name="StockDetail[${i}].net_amount"            value="${d.net_amount}" />
                <input type="hidden" name="StockDetail[${i}].current_date"          value="${d.current_date}" />
            `;
        });

        if (details.length > 0) {
            tbody.innerHTML += `
                <tr class="bg-gray-100 font-bold">
                    <td colspan="7" class="p-3 text-right">Total:</td>
                    <td class="p-3 text-blue-700">${totalAmount.toFixed(2)}</td>
                    <td></td>
                    <td class="p-3 text-orange-600">${totalDiscount.toFixed(2)}</td>
                    <td class="p-3 text-green-700">${totalNet.toFixed(2)}</td>
                    <td colspan="2"></td>
                </tr>`;
        }

        document.querySelector('input[name="StockMaster.total_amount"]').value = totalNet.toFixed(2);
        updateNetAmount();
    }

    function removeDetail(i) {
        details.splice(i, 1);
        renderTable();
    }

    function clearInputs() {
        ["warehouseId", "itemId", "qty", "rate", "amount",
         "discount_percentage", "discount_amount", "net_amount", "currentStockQty"]
            .forEach(id => { document.getElementById(id).value = ""; });
    }

    function updateNetAmount() {
        const total = parseFloat(document.querySelector('input[name="StockMaster.total_amount"]').value) || 0;
        const disc  = parseFloat(document.querySelector('input[name="StockMaster.discount_amount"]').value) || 0;
        const tax   = parseFloat(document.querySelector('input[name="StockMaster.tax_amount"]').value) || 0;
        document.querySelector('input[name="StockMaster.net_amount"]').value = (total - disc + tax).toFixed(2);
    }

        function beforeSave() {
        updateNetAmount();
        let hasError = false;

        // ── Remarks Check ──
        const remarks = document.getElementById("remarksInput");
        document.getElementById("remarksError")?.remove();

        if (!remarks.value.trim()) {
            remarks.classList.add("border-red-500", "border-2");
            remarks.insertAdjacentHTML("afterend",
                '<p id="remarksError" class="mt-1 text-sm font-semibold text-red-600">' +
                '<i class="fa-solid fa-circle-xmark mr-1"></i>Remarks is required.</p>');
            remarks.focus();
            hasError = true;
        } else {
            remarks.classList.remove("border-red-500", "border-2");
        }

        // ── Items Check ──
        document.getElementById("itemsError")?.remove();

        if (details.length === 0) {
            const table = document.querySelector("#detailsTable")?.closest(".overflow-hidden");
            const err = '<div id="itemsError" class="mt-3 px-4 py-3 rounded-lg text-sm font-semibold bg-red-50 text-red-700 border border-red-400">' +
                        '<i class="fa-solid fa-triangle-exclamation mr-2"></i>No items added. Please add at least one item before saving.</div>';
            table ? table.insertAdjacentHTML("beforebegin", err)
                  : document.getElementById("toastArea").insertAdjacentHTML("beforeend", err);
            hasError = true;
        }

        if (hasError) { event.preventDefault(); return false; }
        return true;
    }

    // ── Auto remove remarks error on typing ──
    document.getElementById("remarksInput")?.addEventListener("input", function () {
        if (this.value.trim()) {
            this.classList.remove("border-red-500", "border-2");
            document.getElementById("remarksError")?.remove();
        }
    });

    // ═══════════════════════════════════════════════════
    // TOAST
    // ═══════════════════════════════════════════════════
    function showToast(message, isSuccess = true) {
        const area = document.getElementById("toastArea");
        const div  = document.createElement("div");
        div.className = `mt-2 px-4 py-2 rounded-lg text-sm font-semibold ${
            isSuccess
                ? "bg-green-100 text-green-700 border border-green-300"
                : "bg-red-100 text-red-700 border border-red-300"
        }`;
        div.innerHTML = `<i class="fa-solid ${isSuccess ? 'fa-circle-check' : 'fa-circle-xmark'} mr-2"></i>${message}`;
        area.appendChild(div);
        setTimeout(() => div.remove(), 4000);
    }

    // ═══════════════════════════════════════════════════
    // MODALS
    // ═══════════════════════════════════════════════════
    function openWarehouseModal() {
        document.getElementById('warehouseModal').classList.remove('hidden');
    }
    function closeWarehouseModal() {
        document.getElementById('warehouseModal').classList.add('hidden');
    }
    function openItemModal() {
        fetch('/AssembleDessamble/ItemModal')
            .then(r => r.text())
            .then(html => {
                document.getElementById('itemModalContainer').innerHTML = html;
                document.getElementById('itemModal').classList.remove('hidden');
            });
    }
    function closeItemModal() {
        document.getElementById('itemModal')?.closest('#itemModalContainer')?.remove();
    }

    // ═══════════════════════════════════════════════════
    // EDIT MODE: Load existing details
    // ═══════════════════════════════════════════════════
    @if (Model.StockMaster.Id > 0 && Model.StockDetail?.Any() == true)
    {
            var warehouses = ViewBag.Warehouses as IEnumerable<dynamic>;
            var items = ViewBag.Items as IEnumerable<dynamic>;
            var warehouseDict = warehouses?.ToDictionary(w => (int)w.Id, w => (string)w.warehouse_name) ?? new Dictionary<int, string>();
            var itemDict = items?.ToDictionary(i => (int)i.Id, i => (string)i.item_name) ?? new Dictionary<int, string>();

            var jsonDetails = JsonSerializer.Serialize(Model.StockDetail.Select(d => new
            {
                    warehouseId = d.warehouseId,
                    warehouseName = warehouseDict.ContainsKey(d.warehouseId ?? 0) ? warehouseDict[d.warehouseId ?? 0] : "Unknown",
                    itemId = d.itemId,
                    itemName = itemDict.ContainsKey(d.itemId) ? itemDict[d.itemId] : "Unknown",
                    stockQty = 0,
                    qty = Math.Abs(d.qty),
                    rate = d.rate,
                    amount = d.amount,
                    discount_percentage = d.discount_percentage,
                    discount_amount = d.discount_amount,
                    net_amount = d.net_amount,
                    current_date = d.current_date.ToString("yyyy-MM-dd"),
                    adjType = Model.StockMaster.etype == "StockAdjustment_In" ? "stock-in" : "stock-out"
            }));

            <text>
            details = @Html.Raw(jsonDetails);
            renderTable();
            </text>
    }

    // Initialize tab
    showTab('@activeTab');
</script>
