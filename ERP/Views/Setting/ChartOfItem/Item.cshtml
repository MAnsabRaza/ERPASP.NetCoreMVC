@model ERP.Models.Item
@{
    ViewData["Title"] = "Item";
    var itemList = ViewBag.Item as List<ERP.Models.Item>;
    int totalItems = ViewBag.TotalItems;
    int currentPage = ViewBag.Page;
    int pageSize = ViewBag.PageSize;
    string searchString = ViewBag.SearchString ?? "";
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    string activeTab = ViewBag.ActiveTab ?? "form";
}

<div class="space-y-8">

    <!-- Tabs -->
    <div class="border-b border-gray-300 bg-white shadow-sm rounded-xl p-2">
        <nav class="flex space-x-6" aria-label="Tabs">
            <button id="tab-form"
                    class="px-4 py-2 text-sm font-semibold text-blue-900 border-b-2 border-blue-900 focus:outline-none transition"
                    type="button">
                <i class="fa-solid fa-plus-circle mr-2"></i> Item Entry
            </button>
            <button id="tab-list"
                    class="px-4 py-2 text-sm font-semibold text-gray-500 hover:text-blue-900 hover:border-blue-400 border-b-2 border-transparent focus:outline-none transition"
                    type="button">
                <i class="fa-solid fa-list mr-2"></i> Item List
            </button>
        </nav>
    </div>

    <!-- Form Tab -->
    <div id="content-form" class="tab-content">
        @using (Html.BeginForm("Create", "Item", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id, new { id = "itemId" })

            <!-- Header Card -->
            <div class="shadow-lg rounded-2xl bg-gradient-to-r from-blue-50 to-blue-100 p-6 border border-gray-200">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-2xl font-bold text-blue-800 flex items-center gap-2">
                            <i class="fa-solid fa-boxes text-blue-900"></i> Item Management
                        </h2>
                        <p class="text-gray-600 mt-1 text-sm">Add and manage your inventory items efficiently</p>
                    </div>
                    <div class="space-x-2">
                        <button type="submit"
                                class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-green-600 hover:bg-green-700 shadow-md transition">
                            <i class="fa-solid fa-save mr-2"></i>
                            @(Model.Id > 0 ? "Update" : "Save")
                        </button>
                        <button type="reset"
                                class="px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 bg-yellow-300 hover:bg-yellow-400 shadow-md transition">
                            <i class="fa-solid fa-rotate-right mr-2"></i> Reset
                        </button>
                        <a asp-action="Item" asp-controller="Item"
                           class="inline-flex items-center px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-purple-500 hover:bg-purple-600 shadow-md transition">
                            <i class="fa-solid fa-arrows-rotate mr-2"></i> Refresh
                        </a>
                    </div>
                </div>
            </div>

            <!-- Section 1 — General Info -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 mt-2">
                <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4 border-b border-gray-100 pb-2">
                    <i class="fa-solid fa-circle-info text-blue-500 mr-1"></i> General Info
                </p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Current Date <span class="text-red-500">*</span></label>
                        @Html.TextBoxFor(m => m.current_date, "{0:yyyy-MM-dd}",
                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-400", type = "date", required = "required" })
                    @Html.ValidationMessageFor(m => m.current_date, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Remark</label>
                    @Html.TextBoxFor(m => m.remark,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-400", type = "text", placeholder = "Enter remark..." })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Status</label>
                    <div class="flex items-center gap-3 px-3 py-2 border border-gray-300 rounded-lg bg-gray-50 h-9">
                        @Html.CheckBoxFor(m => m.status, new { @class = "w-4 h-4 text-blue-600 rounded focus:ring-blue-500", id = "statusCheck" })
                        <span class="text-sm font-semibold text-green-600" id="statusLabel">Active</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2 — Item Identity -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 mt-2">
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4 border-b border-gray-100 pb-2">
                <i class="fa-solid fa-barcode text-blue-500 mr-1"></i> Item Identity
            </p>
            <div id="item-identity-grid" class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Item Barcode <span class="text-red-500">*</span></label>
                    @Html.TextBoxFor(m => m.item_barcode,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-400", type = "text", required = "required", placeholder = "Scan or enter barcode" })
                    @Html.ValidationMessageFor(m => m.item_barcode, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Item Name <span class="text-red-500">*</span></label>
                    @Html.TextBoxFor(m => m.item_name,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-400", type = "text", required = "required", placeholder = "Enter item name" })
                    @Html.ValidationMessageFor(m => m.item_name, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Expireable?</label>
                    <div class="flex items-center gap-3 px-3 py-2 border border-gray-300 rounded-lg bg-gray-50 h-9">
                        <input type="checkbox" id="isExpireableCheck" name="isExpireable" value="true"
                               class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500"
                               @(Model.isExpireable == true ? "checked" : "") />
                        <input type="hidden" name="isExpireable" value="false" />
                        <span class="text-sm font-semibold text-gray-500" id="expireableLabel">Not Expireable</span>
                    </div>
                </div>
                <!-- Expiry Date — hidden until isExpireable checked -->
                <div id="expiry-col" class="hidden">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">
                        Expiry Date
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 ml-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700 border border-amber-300">
                            <i class="fa-solid fa-clock text-xs"></i> Required
                        </span>
                    </label>
                    @Html.TextBoxFor(m => m.expiry_date, "{0:yyyy-MM-dd}",
                                        new { @class = "w-full px-3 py-2 text-sm border border-amber-300 rounded-lg bg-amber-50 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400", type = "date", id = "expiry_date_input" })
                </div>
            </div>
        </div>

        <!-- Section 3 — Classification -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 mt-2">
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4 border-b border-gray-100 pb-2">
                <i class="fa-solid fa-tags text-blue-500 mr-1"></i> Classification
            </p>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Brand <span class="text-red-500">*</span></label>
                    @Html.DropDownListFor(m => m.brandId,
                                        new SelectList(ViewBag.brandList, "Id", "brand_name"),
                                        "— Select Brand —",
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", required = "required" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Category <span class="text-red-500">*</span></label>
                    @Html.DropDownListFor(m => m.categoryId,
                                        new SelectList(ViewBag.categoryList, "Id", "category_name"),
                                        "— Select Category —",
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", required = "required" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Sub Category <span class="text-red-500">*</span></label>
                    @Html.DropDownListFor(m => m.subCategoryId,
                                        new SelectList(ViewBag.subCategoryList, "Id", "sub_category_name"),
                                        "— Select Sub Category —",
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", required = "required" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">UOM <span class="text-red-500">*</span></label>
                    @Html.DropDownListFor(m => m.uomId,
                                        new SelectList(ViewBag.uomList, "Id", "uom_name"),
                                        "— Select UOM —",
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", required = "required" })
                </div>
            </div>
        </div>

        <!-- Section 4 — Pricing & Quantity -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 mt-2">
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4 border-b border-gray-100 pb-2">
                <i class="fa-solid fa-coins text-blue-500 mr-1"></i> Pricing & Quantity
            </p>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Quantity <span class="text-red-500">*</span></label>
                    @Html.TextBoxFor(m => m.qty,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", id = "qty", type = "number", min = "0", required = "required", placeholder = "0" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Rate <span class="text-red-500">*</span></label>
                    @Html.TextBoxFor(m => m.rate,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", id = "rate", type = "number", step = "0.01", min = "0", required = "required", placeholder = "0.00" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Purchase Rate <span class="text-red-500">*</span></label>
                    @Html.TextBoxFor(m => m.purchase_rate,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", type = "number", step = "0.01", min = "0", required = "required", placeholder = "0.00" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Sales Rate <span class="text-red-500">*</span></label>
                    @Html.TextBoxFor(m => m.sale_rate,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", type = "number", step = "0.01", min = "0", required = "required", placeholder = "0.00" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Min Stock</label>
                    @Html.TextBoxFor(m => m.min_stock_level,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Max Stock</label>
                    @Html.TextBoxFor(m => m.max_stock_level,
                                        new { @class = "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                </div>
            </div>
        </div>

        <!-- Section 5 — Discounts & Total -->
        <div class="bg-yellow-50 rounded-2xl border border-yellow-200 shadow-sm p-5 mt-2">
            <p class="text-xs font-bold uppercase tracking-widest text-yellow-700 mb-4 border-b border-yellow-200 pb-2">
                <i class="fa-solid fa-percent text-yellow-500 mr-1"></i> Discounts & Total
            </p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Purchase Discount</label>
                    @Html.TextBoxFor(m => m.purchase_dic,
                                        new { @class = "w-full px-3 py-2 text-sm border border-yellow-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400", id = "purchase_dic", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Sales Discount</label>
                    @Html.TextBoxFor(m => m.sale_dic,
                                        new { @class = "w-full px-3 py-2 text-sm border border-yellow-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400", id = "sale_dic", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Discount Amount</label>
                    @Html.TextBoxFor(m => m.discount_amount,
                                        new { @class = "w-full px-3 py-2 text-sm border border-yellow-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400", id = "discount_amount", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Total Amount</label>
                    @Html.TextBoxFor(m => m.total_amount,
                                        new { @class = "w-full px-3 py-2 text-sm border border-blue-300 rounded-lg bg-blue-50 text-blue-800 font-bold focus:outline-none", type = "number", id = "total_amount", @readonly = "readonly", placeholder = "Auto-calculated" })
                </div>
            </div>
        </div>
                }
    </div>

    <!-- List Tab -->
    <div id="content-list" class="tab-content hidden shadow-lg rounded-2xl bg-white p-6 border border-gray-200">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-bold text-blue-800 flex items-center gap-2">
                    <i class="fa-solid fa-list-ul text-blue-900"></i> Items Inventory
                </h2>
                <p class="text-gray-600 text-sm mt-1">View and manage all your items</p>
            </div>
            <div class="flex items-center space-x-4">
                <div class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-blue-900 shadow-md">
                    Total Items: @totalItems
                </div>
                <button type="button" id="btn-add-new"
                        class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-green-600 hover:bg-green-700 shadow-md transition">
                    <i class="fa-solid fa-plus mr-2"></i>Add New
                </button>
            </div>
        </div>

        <!-- Search -->
        <div class="flex justify-between items-center mt-6">
            <div></div>
            <form method="get" asp-action="Item" class="flex items-center space-x-2 w-full max-w-md">
                <input type="hidden" name="activeTab" value="list" />
                <div class="relative w-full">
                    <input type="text" id="searchInput" name="searchString" value="@searchString"
                           placeholder="Search Item..."
                           class="w-full px-4 py-2 pr-10 border rounded-lg focus:ring focus:ring-blue-300" />
                    <button type="button" id="clearSearch"
                            class="absolute inset-y-0 right-2 flex items-center text-gray-400 hover:text-red-500 hidden">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <button type="submit"
                        class="px-4 py-2 bg-blue-900 text-white rounded-lg hover:bg-blue-800">
                    <i class="fa fa-search"></i>
                </button>
            </form>
        </div>

        <!-- Table -->
        <div class="overflow-hidden border border-gray-200 rounded-lg mt-6">
            <div class="overflow-x-auto max-h-[500px] overflow-y-auto">
                <table class="table-auto w-full text-sm">
                    <thead class="bg-gradient-to-r from-blue-800 to-blue-900 text-white sticky top-0">
                        <tr>
                            <th class="p-3 text-left whitespace-nowrap">#</th>
                            <th class="p-3 text-left whitespace-nowrap">Date</th>
                            <th class="p-3 text-left whitespace-nowrap">Barcode</th>
                            <th class="p-3 text-left whitespace-nowrap">Name</th>
                            <th class="p-3 text-left whitespace-nowrap">Status</th>
                            <th class="p-3 text-left whitespace-nowrap">Qty</th>
                            <th class="p-3 text-left whitespace-nowrap">Rate</th>
                            <th class="p-3 text-left whitespace-nowrap">Purchase Rate</th>
                            <th class="p-3 text-left whitespace-nowrap">Sales Rate</th>
                            <th class="p-3 text-left whitespace-nowrap">Discount</th>
                            <th class="p-3 text-left whitespace-nowrap">Total</th>
                            <th class="p-3 text-center whitespace-nowrap">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        @if (itemList != null && itemList.Any())
                        {
                            int serial = (currentPage - 1) * pageSize + 1;
                            foreach (var item in itemList)
                            {
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="p-3 text-gray-500">@serial</td>
                                    <td class="p-3 whitespace-nowrap">@item.current_date.ToString("dd MMM yyyy")</td>
                                    <td class="p-3 whitespace-nowrap font-mono text-xs">@item.item_barcode</td>
                                    <td class="p-3 font-medium whitespace-nowrap">
                                        @item.item_name
                                        @if (item.isExpireable == true)
                                        {
                                            <span class="ml-1 px-1.5 py-0.5 text-xs rounded bg-amber-100 text-amber-700 whitespace-nowrap">
                                                Exp: @item.expiry_date?.ToString("dd MMM yyyy")
                                            </span>
                                        }
                                    </td>
                                    <td class="p-3">
                                        @if (item.status)
                                        {
                                            <span class="px-3 py-1 text-xs font-medium text-green-700 bg-green-100 rounded-full">Active</span>
                                        }
                                        else
                                        {
                                            <span class="px-3 py-1 text-xs font-medium text-red-700 bg-red-100 rounded-full">Inactive</span>
                                        }
                                    </td>
                                    <td class="p-3 whitespace-nowrap">@item.qty @item.UOM?.uom_name</td>
                                    <td class="p-3">@item.rate.ToString("0.00")</td>
                                    <td class="p-3">@item.purchase_rate.ToString("0.00")</td>
                                    <td class="p-3">@item.sale_rate.ToString("0.00")</td>
                                    <td class="p-3">@(item.discount_amount?.ToString("0.00") ?? "—")</td>
                                    <td class="p-3 font-bold text-blue-700">@item.total_amount.ToString("0.00")</td>
                                    <td class="p-3 text-center space-x-2">
                                        <a asp-action="Edit" asp-controller="Item" asp-route-id="@item.Id"
                                           class="px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-100 text-blue-700 hover:bg-blue-200 transition">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        @using (Html.BeginForm("Delete", "Item", FormMethod.Post, new { onsubmit = "return confirm('Are you sure?');", @class = "inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", item.Id)
                                            <button type="submit"
                                                    class="px-3 py-1.5 rounded-lg text-xs font-medium bg-red-100 text-red-700 hover:bg-red-200 transition">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        }
                                    </td>
                                </tr>
                                serial++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="15" class="text-center p-8 text-gray-400">
                                    <i class="fa-solid fa-boxes-stacked text-3xl block mb-2"></i>
                                    No items found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div class="flex justify-between items-center mt-4">
            <span class="text-sm text-gray-600">
                Page <span class="font-semibold">@ViewBag.Page</span>
                of <span class="font-semibold">@(totalPages == 0 ? 1 : totalPages)</span>
                &mdash; Total <span class="font-semibold">@totalItems</span> records
            </span>
            <div class="space-x-2">
                @if (currentPage > 1)
                {
                    <a asp-action="Item" asp-route-page="@(currentPage - 1)"
                       asp-route-searchString="@searchString"
                       asp-route-activeTab="list"
                       class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300">Prev</a>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="Item" asp-route-page="@(currentPage + 1)"
                       asp-route-searchString="@searchString"
                       asp-route-activeTab="list"
                       class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300">Next</a>
                }
            </div>
        </div>
    </div>

</div>

<!-- Scripts -->
<script>
    const tabForm     = document.getElementById("tab-form");
    const tabList     = document.getElementById("tab-list");
    const contentForm = document.getElementById("content-form");
    const contentList = document.getElementById("content-list");
    const btnAddNew   = document.getElementById("btn-add-new");
    const searchInput = document.getElementById("searchInput");
    const clearBtn    = document.getElementById("clearSearch");

    function showFormTab() {
        tabForm.classList.add("text-blue-900", "border-blue-900");
        tabForm.classList.remove("text-gray-500", "border-transparent");
        tabList.classList.remove("text-blue-900", "border-blue-900");
        tabList.classList.add("text-gray-500", "border-transparent");
        contentForm.classList.remove("hidden");
        contentList.classList.add("hidden");
    }

    function showListTab() {
        tabList.classList.add("text-blue-900", "border-blue-900");
        tabList.classList.remove("text-gray-500", "border-transparent");
        tabForm.classList.remove("text-blue-900", "border-blue-900");
        tabForm.classList.add("text-gray-500", "border-transparent");
        contentList.classList.remove("hidden");
        contentForm.classList.add("hidden");
    }

    tabForm.addEventListener("click", showFormTab);
    tabList.addEventListener("click", showListTab);
    if (btnAddNew) btnAddNew.addEventListener("click", showFormTab);

    // ── Status label ──
    const statusCheck = document.getElementById("statusCheck");
    const statusLabel = document.getElementById("statusLabel");
    function updateStatusLabel() {
        if (statusCheck.checked) {
            statusLabel.textContent = "Active";
            statusLabel.className = "text-sm font-semibold text-green-600";
        } else {
            statusLabel.textContent = "Inactive";
            statusLabel.className = "text-sm font-semibold text-red-500";
        }
    }
    statusCheck.addEventListener("change", updateStatusLabel);
    updateStatusLabel();

    // ── isExpireable → show/hide expiry date ──
    const isExpireableCheck = document.getElementById("isExpireableCheck");
    const expiryCol         = document.getElementById("expiry-col");
    const expireableLabel   = document.getElementById("expireableLabel");
    const expiryInput       = document.getElementById("expiry_date_input");
    const identityGrid      = document.getElementById("item-identity-grid");

    function updateExpiryVisibility() {
        if (isExpireableCheck.checked) {
            expiryCol.classList.remove("hidden");
            identityGrid.className = "grid grid-cols-1 md:grid-cols-4 gap-5";
            expireableLabel.textContent = "Expireable";
            expireableLabel.className = "text-sm font-semibold text-blue-600";
            expiryInput.required = true;
        } else {
            expiryCol.classList.add("hidden");
            identityGrid.className = "grid grid-cols-1 md:grid-cols-3 gap-5";
            expireableLabel.textContent = "Not Expireable";
            expireableLabel.className = "text-sm font-semibold text-gray-500";
            expiryInput.required = false;
            expiryInput.value = "";
        }
    }
    isExpireableCheck.addEventListener("change", updateExpiryVisibility);
    updateExpiryVisibility();

    // ── Auto-calculate total ──
    function calculateTotal() {
        const qty      = parseFloat(document.getElementById("qty").value) || 0;
        const rate     = parseFloat(document.getElementById("rate").value) || 0;
        const discount = parseFloat(document.getElementById("discount_amount").value) || 0;
        const total    = (qty * rate) - discount;
        document.getElementById("total_amount").value = total >= 0 ? total.toFixed(2) : "0.00";
    }
    ["qty", "rate", "discount_amount"].forEach(id => {
        document.getElementById(id).addEventListener("input", calculateTotal);
    });

    // ── Search clear ──
    searchInput.addEventListener("input", () => {
        clearBtn.style.display = searchInput.value ? "flex" : "none";
    });
    clearBtn.addEventListener("click", () => {
        window.location.href = '@Url.Action("Item", "Item")?activeTab=list';
    });
    if (searchInput.value) {
        clearBtn.style.display = "flex";
    }

    // ── Active tab from server (e.g. after Edit/Delete redirect) ──
    const serverTab = '@activeTab';
    if (serverTab === 'list') {
        showListTab();
    } else {
        showFormTab();
    }
</script>
