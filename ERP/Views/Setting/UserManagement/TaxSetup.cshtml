@model ERP.Models.TaxSetup
@{
    ViewData["Title"] = "Tax Setup";
    var taxList = ViewBag.TaxList as List<ERP.Models.TaxSetup>;

    int totalItems = ViewBag.TotalItems;
    int page = ViewBag.Page;
    int pageSize = ViewBag.PageSize;
    string searchString = ViewBag.SearchString ?? "";
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
}

<div class="space-y-6">

    @using (Html.BeginForm("Create", "TaxSetup", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.companyId)

        <!-- Header Card -->
        <div class="rounded-2xl bg-gradient-to-r from-blue-50 to-blue-100 p-5 border border-blue-200 shadow-md">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-blue-900 flex items-center gap-2">
                        <i class="fa-solid fa-percent"></i> Tax Setup
                    </h2>
                    <p class="text-gray-500 mt-1 text-sm">Add and manage your Tax records efficiently</p>
                </div>
                <div class="flex gap-2 flex-wrap">
                    <button type="submit"
                            class="inline-flex items-center px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-green-600 hover:bg-green-700 shadow transition">
                        <i class="fa-solid fa-save mr-2"></i>
                        @(Model.Id > 0 ? "Update" : "Save")
                    </button>
                    <a asp-action="TaxSetup" asp-controller="TaxSetup"
                       class="inline-flex items-center px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 bg-yellow-300 hover:bg-yellow-400 shadow transition">
                        <i class="fa-solid fa-rotate-right mr-2"></i> Reset
                    </a>
                </div>
            </div>
        </div>

        <!-- Form Fields -->
        <div class="rounded-2xl bg-white p-6 border border-gray-200 shadow-md space-y-6 mt-2">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                <!-- Tax Name -->
                <div class="flex flex-col gap-1">
                    <label class="text-sm font-semibold text-gray-700">
                        Tax Name <sup class="text-red-600">*</sup>
                    </label>
                    @Html.TextBoxFor(m => m.tax_name, new
                    {
                        @class = "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400",
                        required = "required",
                        placeholder = "e.g. GST, VAT"
                    })
                    @Html.ValidationMessageFor(m => m.tax_name, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>

                <!-- Percentage -->
                <div class="flex flex-col gap-1">
                    <label class="text-sm font-semibold text-gray-700">
                        Percentage (%) <sup class="text-red-600">*</sup>
                    </label>
                    @Html.TextBoxFor(m => m.percentage, new
                    {
                        @class = "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400",
                        type = "number",
                        step = "0.01",
                        min = "0",
                        placeholder = "e.g. 17.00"
                    })
                    @Html.ValidationMessageFor(m => m.percentage, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>

                <!-- Applicable On -->
                <div class="flex flex-col gap-1">
                    <label class="text-sm font-semibold text-gray-700">Applicable On</label>
                    @Html.DropDownListFor(m => m.applicable_on,
                        new SelectList(new[]
                        {
                            new { Value = "Both",    Text = "Both"    },
                            new { Value = "Sales",   Text = "Sales"   },
                            new { Value = "Purchase",Text = "Purchase"}
                        }, "Value", "Text", Model.applicable_on),
                        new
                        {
                            @class = "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white"
                        })
                </div>

                <!-- Status -->
                <div class="flex flex-col gap-1">
                    <label class="text-sm font-semibold text-gray-700">Status</label>
                    @Html.DropDownListFor(m => m.status,
                        new SelectList(new[]
                        {
                            new { Value = "true",  Text = "Active"   },
                            new { Value = "false", Text = "Inactive" }
                        }, "Value", "Text", Model.status.ToString().ToLower()),
                        new
                        {
                            @class = "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white"
                        })
                </div>

            </div>
        </div>
    }

    <!-- Tax List Table -->
    <div class="rounded-2xl bg-white p-6 border border-gray-200 shadow-md">

        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-5">
            <div class="flex items-center gap-3">
                <h3 class="text-xl font-bold text-blue-900 flex items-center gap-2">
                    <i class="fa-solid fa-list text-blue-800"></i> Tax List
                </h3>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                    @totalItems records
                </span>
            </div>

            <!-- Search -->
            <form method="get" asp-action="TaxSetup" asp-controller="TaxSetup"
                  class="flex items-center gap-2 w-full sm:w-auto">
                <div class="relative w-full sm:w-64">
                    <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-400">
                        <i class="fa-solid fa-magnifying-glass text-xs"></i>
                    </span>
                    <input type="text" id="searchInput" name="searchString" value="@searchString"
                           placeholder="Search tax name..."
                           class="w-full pl-8 pr-8 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" />
                    <button type="button" id="clearSearch"
                            class="absolute inset-y-0 right-2 flex items-center text-gray-400 hover:text-red-500 @(string.IsNullOrEmpty(searchString) ? "hidden" : "")">
                        <i class="fa-solid fa-xmark text-xs"></i>
                    </button>
                </div>
                <button type="submit"
                        class="px-4 py-2 bg-blue-900 text-white rounded-lg text-sm font-semibold hover:bg-blue-800 transition whitespace-nowrap">
                    <i class="fa fa-search mr-1"></i> Search
                </button>
            </form>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto rounded-xl border border-gray-200">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gradient-to-r from-blue-800 to-blue-900 text-white text-left">
                        <th class="px-4 py-3 font-semibold">#</th>
                        <th class="px-4 py-3 font-semibold">Tax Name</th>
                        <th class="px-4 py-3 font-semibold">Percentage</th>
                        <th class="px-4 py-3 font-semibold">Applicable On</th>
                        <th class="px-4 py-3 font-semibold text-center">Status</th>
                        <th class="px-4 py-3 font-semibold text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (taxList != null && taxList.Any())
                    {
                        int serial = (page - 1) * pageSize + 1;
                        foreach (var item in taxList)
                        {
                            <tr class="hover:bg-blue-50 transition">
                                <td class="px-4 py-3 text-gray-500 font-semibold">@serial</td>
                                <td class="px-4 py-3 font-semibold text-gray-800">@item.tax_name</td>
                                <td class="px-4 py-3 text-gray-600">@item.percentage?.ToString("0.00") %</td>
                                <td class="px-4 py-3 text-gray-600">@item.applicable_on</td>
                                <td class="px-4 py-3 text-center">
                                    @if (item.status)
                                    {
                                        <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold text-green-700 bg-green-100 rounded-full">
                                            <i class="fa-solid fa-circle-check"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold text-red-700 bg-red-100 rounded-full">
                                            <i class="fa-solid fa-circle-xmark"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a asp-action="Edit" asp-controller="TaxSetup" asp-route-id="@item.Id"
                                           class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-100 text-blue-700 hover:bg-blue-200 transition">
                                            <i class="fa-solid fa-pen mr-1"></i> Edit
                                        </a>
                                        @using (Html.BeginForm("Delete", "TaxSetup", FormMethod.Post,
                                            new { onsubmit = "return confirm('Are you sure you want to delete this Tax?');", @class = "inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", item.Id)
                                            <button type="submit"
                                                    class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-100 text-red-700 hover:bg-red-200 transition">
                                                <i class="fa-solid fa-trash mr-1"></i> Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                            serial++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-gray-400">
                                <i class="fa-solid fa-percent text-3xl block mb-2"></i>
                                No tax records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="flex flex-col sm:flex-row justify-between items-center mt-5 gap-3">
            <span class="text-sm text-gray-500">
                Page <span class="font-semibold text-gray-700">@ViewBag.Page</span>
                of <span class="font-semibold text-gray-700">@(totalPages == 0 ? 1 : totalPages)</span>
                &nbsp;&mdash;&nbsp;
                Total <span class="font-semibold text-gray-700">@totalItems</span> records
            </span>
            <div class="flex gap-2">
                @if (page > 1)
                {
                    <a asp-action="TaxSetup" asp-controller="TaxSetup"
                       asp-route-page="@(page - 1)" asp-route-searchString="@searchString"
                       class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition">
                        <i class="fa-solid fa-chevron-left mr-1 text-xs"></i> Prev
                    </a>
                }
                @if (page < totalPages)
                {
                    <a asp-action="TaxSetup" asp-controller="TaxSetup"
                       asp-route-page="@(page + 1)" asp-route-searchString="@searchString"
                       class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-blue-900 text-white hover:bg-blue-800 transition">
                        Next <i class="fa-solid fa-chevron-right ml-1 text-xs"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<script>
    const searchInput = document.getElementById("searchInput");
    const clearBtn = document.getElementById("clearSearch");

    searchInput.addEventListener("input", () => {
        clearBtn.classList.toggle("hidden", !searchInput.value);
    });

    clearBtn.addEventListener("click", () => {
        searchInput.value = "";
        clearBtn.classList.add("hidden");
        searchInput.focus();
    });
</script>